{
  "colors": {
    "brand": "#5B5BD6",
    "accent": "#F97316",
    "background": "#F6F6F9",
    "surface": "#FFFFFF",
    "text": "#15151F",
    "textSecondary": "#6B6B80",
    "border": "#E4E4EC"
  },
  "colorsDark": {
    "background": "#0B0B10",
    "surface": "#17171F",
    "text": "#F4F4F8",
    "textSecondary": "#A0A0B4",
    "border": "#2A2A36"
  },
  "fonts": {
    "largeTitle": {
      "size": 34,
      "weight": "bold"
    },
    "title": {
      "size": 22,
      "weight": "bold"
    },
    "headline": {
      "size": 17,
      "weight": "semibold"
    },
    "body": {
      "size": 17
    },
    "caption": {
      "size": 13,
      "weight": "medium"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radius": {
    "sm": 8,
    "md": 14,
    "lg": 22,
    "pill": 999
  },
  "shadows": {
    "raised": {
      "radius": 12,
      "x": 0,
      "y": 4,
      "color": "#000000",
      "opacity": 0.08
    }
  },
  "styles": {
    "card": {
      "padding": "$md",
      "background": "$surface",
      "radius": "$lg",
      "shadow": "$raised"
    },
    "secondaryText": {
      "foreground": "$textSecondary",
      "font": "$caption"
    }
  }
}
