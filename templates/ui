def find_project() -> Path:
    env = os.environ.get("UI_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    here = Path(__file__).resolve().parent
    if (here / "design" / "app.json").exists():
        return here
    cur = Path.cwd().resolve()
    for p in [cur] + list(cur.parents):
        if (p / "design" / "app.json").exists():
            return p
    return here


class Project:
    def __init__(self, root: Path):
        self.root = root
        self.design = root / "design"
        self.live = root / ".live"
        self.reference = root / "tools" / "REFERENCE.md"

    def screen_path(self, sid: str) -> Path:
        return self.design / "screens" / f"{sid}.json"


def read_json(path: Path):
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp{os.getpid()}")
    with tmp.open("w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def dump(obj) -> str:
    return json.dumps(obj, indent=2, ensure_ascii=False) + "\n"


def compact(obj) -> str:
    return json.dumps(obj, ensure_ascii=False, separators=(",", ":"))


class UIError(Exception):
    pass


class Escalate(Exception):
    """The request needs Swift (a custom component); exit code 3."""


