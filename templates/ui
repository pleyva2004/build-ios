CHAT_HELP = """type a change, or: undo · pick · tune · next · prev · keep · shot · status · context · !<ops json> · quit"""


def cmd_chat(project: Project, args) -> int:
    backend = make_backend(project, args.model, args.think)
    import threading

    threading.Thread(target=backend.warm, args=(system_prompt(project),), daemon=True).start()
    print(f"ui chat · {backend.name} · {args.model}   ({CHAT_HELP})")
    while True:
        try:
            line = input("ui> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not line:
            continue
        try:
            word = line.split()[0].lower()
            if word in ("quit", "exit", "q"):
                return 0
            if word == "help":
                print(CHAT_HELP)
            elif word == "undo":
                cmd_undo(project, argparse.Namespace(steps=1))
            elif word == "pick":
                cmd_pick(project, argparse.Namespace(timeout=60))
            elif word in ("next", "prev"):
                cmd_variant_step(project, argparse.Namespace(shot=False), 1 if word == "next" else -1)
            elif word == "keep":
                cmd_keep(project, args)
            elif word == "shot":
                print(take_screenshot(project))
            elif word == "tune":
                cmd_tune(project, argparse.Namespace(id=line.split()[1] if len(line.split()) > 1 else None))
            elif word == "status":
                cmd_status(project, args)
            elif word == "context":
                print(build_context(project))
            elif line.startswith("!"):
                run_ops(project, parse_ops(line[1:]), note="(manual ops)")
            else:
                n = 1
                m = re.match(r"^-n\s*(\d+)\s+(.*)$", line)
                if m:
                    n, line = int(m.group(1)), m.group(2)
                ask(project, backend, line, variants=n)
        except Escalate as e:
            print(f"ESCALATE: {e}")
        except UIError as e:
            print(f"error {e}")


