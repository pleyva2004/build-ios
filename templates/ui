# Normalization (auto-fix) + id assignment
# --------------------------------------------------------------------------


class Fixer:
    def __init__(self, design: Design):
        self.design = design
        self.notes: list = []
        self.taken = set(design.all_ids()) | set(design.screens)

    def new_id(self, base: str, hint: str) -> str:
        """`<screen>.<slug>`: short ids that don't encode the tree, so they stay true after moves."""
        hint = hint or "item"
        base = (base or "").split(".")[0]
        cand = f"{base}.{hint}" if base else hint
        n = 2
        out = cand
        while out in self.taken:
            out = f"{cand}{n}"
            n += 1
        self.taken.add(out)
        return out

    def hint_for(self, node: dict) -> str:
        t = node.get("type", "node")
        for k in ("text", "symbol", "name", "placeholder", "header"):
            v = node.get(k)
            if isinstance(v, str) and v.strip() and "{{" not in v:
                s = slug(v.replace(".", " "))
                if s:
                    return s
        return t if isinstance(t, str) else "node"

    def normalize_props(self, node: dict, label: str) -> None:
        t = node.get("type")
        if isinstance(t, str) and t not in NODE_TYPES:
            fixed = TYPE_ALIASES.get(t) or TYPE_ALIASES.get(t.lower()) or (t.lower() if t.lower() in NODE_TYPES else None)
            if fixed:
                if fixed == "shape" and t.lower() in {"rectangle", "circle", "capsule"} and "shape" not in node:
                    node["shape"] = {"rectangle": "rect"}.get(t.lower(), t.lower())
                node["type"] = fixed
                self.notes.append(f"{label}: type {t}→{fixed}" if label else f": type {t}→{fixed}")
                t = fixed
        allowed = COMMON_PROPS | TYPE_PROPS.get(t, set()) | STRUCTURAL
        for k in list(node.keys()):
            # onTap is a common prop, but a button only runs "action" (Swift ignores its onTap)
            if (k in allowed and not (k == "onTap" and t == "button")) or k.startswith("_") or t == "custom":
                continue
            target = PROP_ALIASES.get(k)
            if k == "color" and t == "shape":
                target = "fill"
            if k == "image" and t == "button":
                target = "symbol"
            if k == "title" and t in {"section"}:
                target = "header"
            if k == "action" and t != "button":
                target = "onTap"
            if (k == "onTap" or target == "onTap") and t == "button":
                target = "action"
            if target and target not in node and (target in allowed):
                node[target] = node.pop(k)
                self.notes.append(f"{label}: {k}→{target}" if label else f": {k}→{target}")
        self.normalize_values(node, label)
        # "style": "primary" on a button means variant (unless a style bundle has that name)
        styles = self.design.tokens.get("styles") if isinstance(self.design.tokens.get("styles"), dict) else {}
        if t == "button" and node.get("style") in ENUMS["variant"] and node.get("style") not in styles:
            if "variant" not in node:
                node["variant"] = node.pop("style")
                self.notes.append(f"{label}: style→variant" if label else ": style→variant")

    def normalize_values(self, node: dict, label: str) -> None:
        tokens = self.design.tokens if isinstance(self.design.tokens, dict) else {}
        colors = set(tokens.get("colors") or {}) | set(tokens.get("colorsDark") or {})
        spaces = set(tokens.get("spacing") or {}) | set(tokens.get("radius") or {})
        tag = label or ""
        for k in list(node.keys()):
            v = node[k]
            if not isinstance(v, str) or "{{" in v:
                continue
            new = v
            if k in COLOR_PROPS or k == "background":
                if v in colors and v not in BASIC_COLORS:
                    new = "$" + v
                elif v.lower() in CSS_COLORS and v.lower() not in NAMED_COLORS:
                    new = CSS_COLORS[v.lower()]
            elif k in ALIGN_PROPS:
                new = DIRECTION_FIX.get(v, v)
            elif k in NUMBER_PROPS or k in INT_PROPS or k in ("radius", "padding"):
                if v in spaces:
                    new = "$" + v
                else:
                    try:
                        num = float(v)
                        if abs(num) < float("inf"):  # "infinity" stays a string; NaN is skipped
                            new = int(num) if num.is_integer() else num
                    except ValueError:
                        pass
            elif k in ENUMS and v not in ENUMS[k]:
                low = {e.lower(): e for e in ENUMS[k]}
                new = low.get(v.lower(), v)
            if new != v:
                node[k] = new
                self.notes.append(f"{tag}: {k} {compact(v)}→{compact(new)}")
        op = node.get("opacity")
        if isinstance(op, (int, float)) and not isinstance(op, bool) and 1 < op <= 100:
            node["opacity"] = round(op / 100, 3)
            self.notes.append(f"{tag}: opacity {op}→{node['opacity']}")

    def fix_tree(self, node, parent_id: str) -> None:
        if not isinstance(node, dict):
            return
        before = len(self.notes)
        self.normalize_props(node, "")
        if not isinstance(node.get("id"), str) or not node.get("id"):
            node["id"] = self.new_id(parent_id, self.hint_for(node))
            # move id right after type for readable files
            items = list(node.items())
            node.clear()
            order = [kv for kv in items if kv[0] == "type"] + [kv for kv in items if kv[0] == "id"] + \
                [kv for kv in items if kv[0] not in ("type", "id")]
            node.update(order)
        nid = node["id"]
        self.notes[before:] = [f"{nid}{n}" for n in self.notes[before:]]
        kids = node.get("children")
        if isinstance(kids, list):
            for c in kids:
                self.fix_tree(c, nid)
        if isinstance(node.get("template"), dict):
            self.fix_tree(node["template"], nid)


