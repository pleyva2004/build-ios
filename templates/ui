class Validator:
    def __init__(self, design: Design):
        self.d = design
        self.errors: list = []
        self.warnings: list = []
        tk = design.tokens if isinstance(design.tokens, dict) else {}
        self.colors = set(tk.get("colors", {}) or {}) | set(tk.get("colorsDark", {}) or {})
        self.fonts = set(tk.get("fonts", {}) or {})
        self.spacing = set(tk.get("spacing", {}) or {})
        self.radius = set(tk.get("radius", {}) or {})
        self.shadows = set(tk.get("shadows", {}) or {})
        self.styles = tk.get("styles", {}) if isinstance(tk.get("styles"), dict) else {}
        status = Live(design.project).status() or {}
        comps = status.get("components")
        self.components = set(comps) if isinstance(comps, dict) else None

    def err(self, where: str, msg: str) -> None:
        self.errors.append(f"{where}: {msg}")

    def run(self) -> "Validator":
        self.errors.extend(self.d.load_errors)
        self.check_app()
        seen: dict = {}
        for sid, screen in self.d.screens.items():
            self.check_screen(sid, screen)
        for loc in self.d.walk():
            nid = loc.node.get("id")
            where = f"screens/{loc.screen}.json"
            if not isinstance(nid, str) or not nid:
                self.err(f"{where} ({loc.node.get('type', '?')} under {loc.ancestors[-1] if loc.ancestors else loc.screen})",
                         "missing \"id\"")
            elif not ID_RE.match(nid):
                self.err(nid, "id may only use letters, digits, '.', '_' and '-'")
            elif nid.startswith("ex."):
                self.err(nid, "ids starting with 'ex.' come from the reference examples; use the real ids in the context")
            elif nid in seen:
                self.err(nid, f"duplicate id (also in screens/{seen[nid]}.json)")
            else:
                seen[nid] = loc.screen
            self.check_node(loc)
        for sid in self.d.screens:
            if sid in seen:
                self.err(sid, "a node id equals a screen id; rename the node")
        self.check_tokens()
        return self

    # app / screens ------------------------------------------------------

    def check_app(self) -> None:
        app = self.d.app
        tabs = app.get("tabs")
        if tabs is not None:
            if not isinstance(tabs, list) or not tabs:
                self.err("app.json", "\"tabs\" must be a non-empty list")
            else:
                ids = set()
                for i, t in enumerate(tabs):
                    if not isinstance(t, dict):
                        self.err(f"app.json tabs[{i}]", "must be an object")
                        continue
                    tid = t.get("id")
                    if not isinstance(tid, str):
                        self.err(f"app.json tabs[{i}]", "needs \"id\"")
                    elif tid in ids:
                        self.err(f"app.json tabs[{i}]", f"duplicate tab id '{tid}'")
                    ids.add(tid)
                    scr = t.get("screen") or tid
                    if scr not in self.d.screens:
                        self.err(f"app.json tabs[{i}]", f"screen '{scr}' does not exist.{suggest(str(scr), self.d.screens)}")
        else:
            root = app.get("root")
            if root is None and not self.d.screens:
                self.err("app.json", "needs \"tabs\" or \"root\"")
            elif root is not None and root not in self.d.screens:
                self.err("app.json", f"root screen '{root}' does not exist.{suggest(str(root), self.d.screens)}")
        if "tint" in app:
            self.check_color("app.json", "tint", app["tint"])
        cs = app.get("colorScheme")
        if cs is not None and cs not in {"light", "dark", "system"}:
            self.err("app.json", "colorScheme must be light, dark or system")
        if "state" in app and not isinstance(app["state"], dict):
            self.err("app.json", "\"state\" must be an object")

    def check_screen(self, sid: str, screen: dict) -> None:
        where = f"screens/{sid}.json"
        if screen.get("id") not in (None, sid):
            self.err(where, f"\"id\" is '{screen.get('id')}' but the file is {sid}.json")
        if "titleDisplay" in screen and screen["titleDisplay"] not in {"large", "inline", "hidden"}:
            self.err(where, "titleDisplay must be large, inline or hidden")
        if "background" in screen:
            self.check_fill(where, "background", screen["background"])
        if "data" in screen and not isinstance(screen["data"], dict):
            self.err(where, "\"data\" must be an object")
        if "toolbar" in screen and not isinstance(screen["toolbar"], list):
            self.err(where, "\"toolbar\" must be a list of nodes")
        body = screen.get("body")
        if body is None:
            self.err(where, "missing \"body\"")
        elif not isinstance(body, (dict, list)):
            self.err(where, "\"body\" must be a node")

    # nodes --------------------------------------------------------------

    def check_node(self, loc: Loc) -> None:
        n = loc.node
        nid = n.get("id") if isinstance(n.get("id"), str) else f"({loc.screen})"
        t = n.get("type")
        if not isinstance(t, str) or t not in NODE_TYPES:
            self.err(nid, f"unknown type {compact(t)}.{suggest(str(t), NODE_TYPES)} Types: {', '.join(sorted(NODE_TYPES))}")
            return
        allowed = COMMON_PROPS | TYPE_PROPS[t] | STRUCTURAL
        for k, v in n.items():
            if k.startswith("_"):
                continue
            if t == "custom" and k not in STRUCTURAL:
                continue
            if k not in allowed:
                alias = PROP_ALIASES.get(k)
                hint = f" Use \"{alias}\"." if alias in allowed else suggest(k, allowed - STRUCTURAL)
                self.err(nid, f"\"{k}\" is not a {t} property.{hint}")
                continue
            self.check_prop(nid, t, k, v)
        if "children" in n:
            if t not in HAS_CHILDREN:
                self.err(nid, f"a {t} cannot have children")
            elif not isinstance(n["children"], list):
                self.err(nid, "\"children\" must be a list")
        if t == "repeat":
            if not isinstance(n.get("template"), dict):
                self.err(nid, "repeat needs a \"template\" node")
            if "items" not in n:
                self.err(nid, "repeat needs \"items\" (\"data.<key>\", a list, or a count)")
            else:
                self.check_items(loc, n["items"])
        elif "template" in n:
            self.err(nid, "only repeat nodes have \"template\"")
        if t == "image" and not any(k in n for k in ("symbol", "asset", "url")):
            self.err(nid, "image needs \"symbol\", \"asset\" or \"url\"")
        if t == "custom" and not isinstance(n.get("name"), str):
            self.err(nid, "custom needs \"name\"")
        elif t == "custom" and self.components is not None and n["name"] not in self.components:
            self.warnings.append(f"{nid}: custom '{n['name']}' is not registered in Sources/Components "
                                 f"(known: {', '.join(sorted(self.components)) or 'none'}) — it needs Swift + ./run.sh")
        # props that are valid but would change nothing on screen
        if "frameAlign" in n and not any(k in n for k in ("width", "height", "maxWidth", "maxHeight", "minWidth", "minHeight")):
            self.warnings.append(f"{nid}: frameAlign does nothing without width/height/maxWidth (try maxWidth:\"infinity\")")
        if "textAlign" in n and t == "text" and "maxWidth" not in n and "width" not in n:
            self.warnings.append(f"{nid}: textAlign only affects multi-line text; to center a line also set maxWidth:\"infinity\" + frameAlign:\"center\"")
        if t == "section" and loc.parent is not None and loc.parent.get("type") not in ("list",) and loc.key != "template":
            self.warnings.append(f"{nid}: section outside a list renders as a titled column")

    def is_dynamic(self, v) -> bool:
        return isinstance(v, str) and "{{" in v

    def check_prop(self, nid: str, t: str, k: str, v) -> None:
        if v is None:
            self.err(nid, f"\"{k}\" is null (omit it instead)")
            return
        if self.is_dynamic(v):
            return
        if k == "align":
            allowed = ALIGN_BY_TYPE.get(t, ALIGN_9)
            if t == "scroll":
                allowed = ALIGN_BY_TYPE["vstack"] | ALIGN_BY_TYPE["hstack"]
            if v not in allowed:
                self.err(nid, f"align '{v}' not valid for {t}; use one of {', '.join(sorted(allowed))}")
        elif k in ENUMS:
            if v not in ENUMS[k]:
                self.err(nid, f"{k} '{v}' must be one of {', '.join(sorted(ENUMS[k]))}")
        elif k == "background":
            self.check_fill(nid, k, v)
        elif k in COLOR_PROPS:
            self.check_color(nid, k, v)
        elif k == "radius":
            self.check_number(nid, k, v, self.radius | self.spacing)
        elif k in NUMBER_PROPS:
            self.check_number(nid, k, v, self.spacing | self.radius)
        elif k in INT_PROPS:
            if not (isinstance(v, int) and not isinstance(v, bool)):
                self.err(nid, f"{k} must be an integer")
            elif k == "columns" and not 1 <= v <= 12:
                self.err(nid, "columns must be 1–12")
            elif k == "lines" and v < 1:
                self.err(nid, "lines must be 1 or more")
        elif k in BOOL_PROPS:
            if not isinstance(v, bool):
                self.err(nid, f"{k} must be true or false")
        elif k == "padding":
            self.check_padding(nid, v)
        elif k == "font":
            self.check_font(nid, v)
        elif k == "shadow":
            self.check_shadow(nid, v)
        elif k == "style":
            name = v[1:] if isinstance(v, str) and v.startswith("$") else v
            if not isinstance(name, str) or name not in self.styles:
                hint = " (for button looks use \"variant\")" if t == "button" and name in ENUMS["variant"] else ""
                self.err(nid, f"style '{v}' is not in tokens.styles{hint}.{suggest(str(name), self.styles)}")
        elif k in ("action", "onTap"):
            self.check_action(nid, v)
        elif k == "glass":
            if v not in (True, False, "regular", "clear", "none"):
                self.err(nid, "glass must be true, false, \"regular\" or \"clear\"")
        elif k == "offset":
            if not isinstance(v, dict) or set(v) - {"x", "y"}:
                self.err(nid, "offset must be {\"x\": n, \"y\": n}")
        elif k == "border":
            if not isinstance(v, dict) or set(v) - {"color", "width"}:
                self.err(nid, "border must be {\"color\": c, \"width\": n}")
            elif "color" in v:
                self.check_color(nid, "border.color", v["color"])
        elif k == "options":
            if not isinstance(v, list) or not all(isinstance(o, (str, int, float)) for o in v):
                self.err(nid, "options must be a list of strings")
        elif k == "visibleIf":
            if not isinstance(v, str) or not v.strip():
                self.err(nid, "visibleIf must be \"key\", \"!key\" or \"key==value\"")
        elif k in ("text", "symbol", "asset", "url", "placeholder", "bind", "header", "footer", "name"):
            if not isinstance(v, (str, int, float)) or isinstance(v, bool):
                self.err(nid, f"{k} must be a string")
            elif k == "symbol" and isinstance(v, str):
                names = symbol_names()
                if names is not None and v not in names:
                    self.err(nid, f"'{v}' is not an SF Symbol name.{suggest(v, names)}")

    def check_color(self, where: str, k: str, v) -> None:
        if self.is_dynamic(v):
            return
        if not isinstance(v, str):
            self.err(where, f"{k} must be a color string")
        elif v.startswith("$"):
            if v[1:] not in self.colors:
                self.err(where, f"{k}: no color token '{v}'.{suggest(v[1:], self.colors)} Add it with "
                                f"{{\"op\":\"token\",\"path\":\"colors.{v[1:]}\",\"value\":\"#RRGGBB\"}}")
        elif v.startswith("#"):
            if not HEX_RE.match(v):
                self.err(where, f"{k}: '{v}' is not #RGB, #RRGGBB or #RRGGBBAA")
        elif v not in NAMED_COLORS:
            self.err(where, f"{k}: unknown color '{v}' (use #RRGGBB, a $token, or a system name).{suggest(v, NAMED_COLORS)}")

    def check_fill(self, where: str, k: str, v) -> None:
        if isinstance(v, dict):
            stops = v.get("gradient")
            if not isinstance(stops, list) or len(stops) < 2:
                self.err(where, f"{k}: gradient needs a list of 2+ colors")
                return
            for c in stops:
                self.check_color(where, f"{k}.gradient", c)
            if v.get("direction", "down") not in {"down", "up", "right", "diagonal"}:
                self.err(where, f"{k}: direction must be down, up, right or diagonal")
        else:
            self.check_color(where, k, v)

    LIMITS = {"opacity": (0, 1), "size": (1, 400), "aspect": (0.05, 20), "value": (0, 1)}

    def check_number(self, where: str, k: str, v, tokens: set) -> None:
        if isinstance(v, bool):
            self.err(where, f"{k} must be a number")
        elif isinstance(v, (int, float)):
            lo, hi = self.LIMITS.get(k.split(".")[-1], (-100000, 100000))
            if v != v or not (lo <= v <= hi):
                self.err(where, f"{k} must be between {lo} and {hi}")
        elif isinstance(v, str):
            if v.startswith("$"):
                if v[1:] not in tokens:
                    self.err(where, f"{k}: no spacing/radius token '{v}'.{suggest(v[1:], tokens)}")
            elif v in ("infinity", "inf", "max"):
                if k not in {"width", "height", "maxWidth", "maxHeight"}:
                    self.err(where, f"{k} cannot be infinity")
            else:
                try:
                    float(v)
                except ValueError:
                    self.err(where, f"{k} must be a number, a $token or \"infinity\"")
        else:
            self.err(where, f"{k} must be a number")

    def check_padding(self, where: str, v) -> None:
        if isinstance(v, dict):
            bad = set(v) - {"top", "bottom", "leading", "trailing", "horizontal", "vertical", "all"}
            if bad:
                self.err(where, f"padding keys must be top/bottom/leading/trailing/horizontal/vertical (got {', '.join(sorted(bad))})")
            for kk, vv in v.items():
                if kk not in bad:
                    self.check_number(where, f"padding.{kk}", vv, self.spacing)
        else:
            self.check_number(where, "padding", v, self.spacing)

    def check_font(self, where: str, v) -> None:
        if isinstance(v, str):
            if v.startswith("$"):
                if v[1:] not in self.fonts:
                    self.err(where, f"font: no font token '{v}'.{suggest(v[1:], self.fonts)}")
            elif v not in TEXT_STYLES:
                self.err(where, f"font '{v}' is not a token or a text style ({', '.join(sorted(TEXT_STYLES))})")
        elif isinstance(v, dict):
            bad = set(v) - {"size", "weight", "design", "style"}
            if bad:
                self.err(where, f"font object keys are size/weight/design/style (got {', '.join(sorted(bad))})")
            if "weight" in v and v["weight"] not in ENUMS["weight"]:
                self.err(where, f"font weight must be one of {', '.join(sorted(ENUMS['weight']))}")
        else:
            self.err(where, "font must be a $token, a text style name, or {\"size\",\"weight\",\"design\"}")

    def check_shadow(self, where: str, v) -> None:
        if isinstance(v, str):
            if v == "none":
                return
            name = v[1:] if v.startswith("$") else v
            if name not in self.shadows:
                self.err(where, f"shadow: no shadow token '{v}'.{suggest(name, self.shadows)}")
        elif isinstance(v, dict):
            bad = set(v) - {"radius", "x", "y", "color", "opacity"}
            if bad:
                self.err(where, f"shadow keys are radius/x/y/color/opacity (got {', '.join(sorted(bad))})")
        else:
            self.err(where, "shadow must be a $token or an object")

    def check_action(self, where: str, v) -> None:
        if isinstance(v, list):
            for a in v:
                self.check_action(where, a)
            return
        if not isinstance(v, dict):
            self.err(where, "action must be an object like {\"navigate\":\"screen\"}")
            return
        verbs = [k for k in v if k in ACTION_VERBS]
        extra = [k for k in v if k not in ACTION_VERBS and k != "params"]
        if len(verbs) != 1 or extra:
            self.err(where, f"action needs exactly one of {', '.join(sorted(ACTION_VERBS))} (got {compact(v)})")
            return
        verb = verbs[0]
        target = v[verb]
        if verb in ("navigate", "sheet") and not self.is_dynamic(target):
            if target not in self.d.screens:
                self.err(where, f"{verb}: screen '{target}' does not exist.{suggest(str(target), self.d.screens)} "
                                f"Create it with a \"screen\" op.")
        if verb == "tab":
            tabs = [t.get("id") for t in self.d.app.get("tabs", []) if isinstance(t, dict)]
            if target not in tabs:
                self.err(where, f"tab '{target}' does not exist.{suggest(str(target), tabs)}")
        if verb == "set" and not isinstance(target, dict):
            self.err(where, "set needs an object of state values")
        if verb == "alert" and not isinstance(target, dict):
            self.err(where, "alert needs {\"title\",\"message\"}")
        if "params" in v and not isinstance(v["params"], dict):
            self.err(where, "params must be an object")

    def check_items(self, loc: Loc, items) -> None:
        nid = loc.node.get("id", "repeat")
        if isinstance(items, list) or (isinstance(items, int) and not isinstance(items, bool)):
            n = len(items) if isinstance(items, list) else items
            if not 0 <= n <= 500:
                self.err(nid, "repeat renders at most 500 items")
            return
        if not isinstance(items, str):
            self.err(nid, "items must be \"data.<key>\", a list, or a count")
            return
        path = items.replace("{{", "").replace("}}", "").lstrip("$").strip()
        if path.startswith("data."):
            data = self.d.screens.get(loc.screen, {}).get("data", {})
            if resolve_path(data, path[5:]) is None:
                keys = list(data) if isinstance(data, dict) else []
                self.err(nid, f"items '{items}': screens/{loc.screen}.json has no data.{path[5:]}.{suggest(path[5:], keys)}")

    def check_tokens(self) -> None:
        tk = self.d.tokens
        if not isinstance(tk, dict):
            return
        for group in ("colors", "colorsDark"):
            for name, val in (tk.get(group) or {}).items():
                if isinstance(val, str) and val.startswith("$"):
                    if val[1:] not in self.colors:
                        self.err(f"tokens.{group}.{name}", f"refers to missing color '{val}'")
                else:
                    self.check_color(f"tokens.{group}.{name}", "value", val)
        for group in ("spacing", "radius"):
            for name, val in (tk.get(group) or {}).items():
                if not isinstance(val, (int, float)) or isinstance(val, bool):
                    self.err(f"tokens.{group}.{name}", "must be a number")
        for name, val in (tk.get("fonts") or {}).items():
            self.check_font(f"tokens.fonts.{name}", val)
        for name, bundle in self.styles.items():
            if not isinstance(bundle, dict):
                self.err(f"tokens.styles.{name}", "must be an object of props")
                continue
            for k, v in bundle.items():
                if k not in COMMON_PROPS and not any(k in s for s in TYPE_PROPS.values()):
                    self.err(f"tokens.styles.{name}", f"unknown prop \"{k}\"")
                elif k == "style":
                    self.err(f"tokens.styles.{name}", "styles cannot nest \"style\"")
                else:
                    self.check_prop(f"tokens.styles.{name}", "style", k, v)


def resolve_path(root, path: str):
    cur = root
    for part in [p for p in path.split(".") if p]:
        if isinstance(cur, dict):
            cur = cur.get(part)
        elif isinstance(cur, list) and part.isdigit() and int(part) < len(cur):
            cur = cur[int(part)]
        else:
            return None
    return cur


