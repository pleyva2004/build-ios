OP_NAMES = ("set", "insert", "remove", "move", "replace", "wrap", "unwrap", "token", "screen", "path", "nudge", "data")

TYPE_SCALE = [11, 12, 13, 15, 17, 20, 22, 24, 28, 34, 40, 48, 56, 64]
TEXT_STYLE_SIZES = {"largeTitle": 34, "title": 28, "title2": 22, "title3": 20, "headline": 17, "body": 17,
                    "callout": 16, "subheadline": 15, "footnote": 13, "caption": 12, "caption2": 11}
WEIGHT_ORDER = ["ultraLight", "thin", "light", "regular", "medium", "semibold", "bold", "heavy", "black"]
NUDGE_PROPS = ("size", "padding", "spacing", "radius", "weight", "opacity", "width", "height")


def parse_ops(raw) -> list:
    if isinstance(raw, str):
        text = raw.strip()
        if text.startswith("@"):
            text = Path(text[1:]).read_text(encoding="utf-8")
        try:
            raw = json.loads(text)
        except json.JSONDecodeError as e:
            extracted = extract_json(text)
            if extracted is None:
                raise UIError(f"ops are not valid JSON: {e.msg} (line {e.lineno}, col {e.colno})")
            raw = extracted
    if isinstance(raw, dict) and "ops" in raw:
        raw = raw["ops"]
    if isinstance(raw, dict):
        raw = [raw]
    if not isinstance(raw, list):
        raise UIError("ops must be an op object or a list of ops")
    for i, op in enumerate(raw):
        if not isinstance(op, dict) or op.get("op") not in OP_NAMES:
            got = op.get("op") if isinstance(op, dict) else op
            raise UIError(f"op #{i + 1}: unknown op {compact(got)}.{suggest(str(got), OP_NAMES)} Ops: {', '.join(OP_NAMES)}")
    return raw


def extract_json(text: str):
    """Pulls the first JSON object/array out of model text (handles ``` fences)."""
    fence = re.search(r"```(?:json)?\s*(.*?)```", text, re.S)
    if fence:
        try:
            return json.loads(fence.group(1))
        except json.JSONDecodeError:
            pass
    # Try every "{" / "[" in text order: "Change [1 of 1]: {...}" must yield the object.
    for start, opener in [(i, c) for i, c in enumerate(text) if c in "{["]:
        closer = "}" if opener == "{" else "]"
        depth = 0
        in_str = False
        esc = False
        for i in range(start, len(text)):
            ch = text[i]
            if in_str:
                if esc:
                    esc = False
                elif ch == "\\":
                    esc = True
                elif ch == '"':
                    in_str = False
                continue
            if ch == '"':
                in_str = True
            elif ch == opener:
                depth += 1
            elif ch == closer:
                depth -= 1
                if depth == 0:
                    try:
                        return json.loads(text[start:i + 1])
                    except json.JSONDecodeError:
                        break
    return None


def set_path(root, path: str, value, label: str):
    parts = [p for p in str(path).split(".") if p != ""]
    if not parts:
        raise UIError(f"{label}: empty path")
    cur = root
    for i, part in enumerate(parts[:-1]):
        nxt = parts[i + 1]
        if isinstance(cur, dict):
            if part not in cur or not isinstance(cur[part], (dict, list)):
                if value is None:
                    return
                cur[part] = [] if nxt.isdigit() or nxt in ("-", "append") else {}
            cur = cur[part]
        elif isinstance(cur, list):
            if not part.isdigit() or int(part) >= len(cur):
                raise UIError(f"{label}: index '{part}' out of range in '{path}'")
            cur = cur[int(part)]
        else:
            raise UIError(f"{label}: cannot descend into '{part}' in '{path}'")
    last = parts[-1]
    if isinstance(cur, dict):
        if value is None:
            cur.pop(last, None)
        else:
            cur[last] = value
    elif isinstance(cur, list):
        if last in ("-", "append"):
            if value is not None:
                cur.append(value)
        elif last.isdigit() and int(last) < len(cur):
            if value is None:
                del cur[int(last)]
            else:
                cur[int(last)] = value
        elif last.isdigit() and int(last) == len(cur) and value is not None:
            cur.append(value)
        else:
            raise UIError(f"{label}: index '{last}' out of range in '{path}'")
    else:
        raise UIError(f"{label}: cannot set '{last}' in '{path}'")


class Applier:
    """Applies ops to a Design in memory, recording which ids changed."""

    def __init__(self, design: Design):
        self.d = design
        self.fixer = Fixer(design)
        self.changed: list = []
        self.summary: list = []

    def mark(self, *ids) -> None:
        for i in ids:
            if i and i not in self.changed:
                self.changed.append(i)

    def apply_all(self, ops: list) -> None:
        for i, op in enumerate(ops):
            try:
                getattr(self, "op_" + op["op"])(op)
            except UIError as e:
                raise UIError(f"op #{i + 1} ({op['op']}): {e}")

    # targets --------------------------------------------------------------

    def resolve_slot(self, op: dict):
        """Returns (list, index) where a node should go, from after/before/parent(+index)."""
        if "after" in op or "before" in op:
            ref = op.get("after", op.get("before"))
            loc = self.d.find(ref)
            if not loc.in_list:
                raise UIError(f"'{ref}' is a {'repeat template' if loc.key == 'template' else 'screen body'}; "
                              f"insert into its parent or wrap it instead")
            return loc.holder, loc.key + (1 if "after" in op else 0)
        if "parent" in op:
            pid = op["parent"]
            if isinstance(pid, str) and pid.endswith(".toolbar") and pid[:-8] in self.d.screens \
                    and pid not in self.d.index():
                holder = self.d.screens[pid[:-8]].setdefault("toolbar", [])
                idx = op.get("index", len(holder))
                if not isinstance(idx, int) or isinstance(idx, bool):
                    raise UIError("index must be an integer")
                return holder, max(0, min(idx if idx >= 0 else len(holder) + 1 + idx, len(holder)))
            if pid in self.d.screens and pid not in self.d.index():
                body = self.d.screens[pid].get("body")
                if isinstance(body, list):
                    holder = body
                elif isinstance(body, dict) and body.get("type") in CONTAINERS:
                    holder = body.setdefault("children", [])
                else:
                    raise UIError(f"screen '{pid}' body is not a container; use replace on its body")
            else:
                loc = self.d.find(pid)
                ptype = loc.node.get("type")
                if ptype == "repeat":
                    raise UIError(f"'{pid}' is a repeat; insert into its template ('{loc.node.get('template', {}).get('id')}') instead")
                if ptype not in HAS_CHILDREN:
                    raise UIError(f"'{pid}' is a {ptype} and cannot have children; use wrap to group it with the new node")
                holder = loc.node.setdefault("children", [])
            idx = op.get("index", len(holder))
            if not isinstance(idx, int) or isinstance(idx, bool):
                raise UIError("index must be an integer")
            if idx < 0:
                idx = len(holder) + 1 + idx
            return holder, max(0, min(idx, len(holder)))
        raise UIError("needs \"after\", \"before\" or \"parent\"")

    def parent_id_of_slot(self, holder) -> str:
        for loc in self.d.walk():
            if loc.node.get("children") is holder:
                return loc.node.get("id", "")
        for sid, s in self.d.screens.items():
            if s.get("toolbar") is holder:
                return sid
            if s.get("body") is holder:
                return sid
        return ""

    def new_node(self, node, parent_id: str) -> dict:
        if not isinstance(node, dict):
            raise UIError("\"node\" must be an object")
        node = copy.deepcopy(node)
        self.fixer.fix_tree(node, parent_id)
        return node

    # ops -------------------------------------------------------------------

    def op_set(self, op: dict) -> None:
        nid = op.get("id")
        props = op.get("props")
        if not isinstance(props, dict) or not props:
            raise UIError("needs \"props\": {...}")
        if nid in self.d.screens and nid not in self.d.index():
            screen = self.d.screens[nid]
            for k, v in props.items():
                if k in ("id", "body"):
                    raise UIError(f"cannot set screen '{k}' with set (use replace on the body / a screen op)")
                if k == "toolbar" and screen.get("toolbar") and op.get("replaceToolbar") is not True:
                    raise UIError(f"set would replace the whole toolbar; insert with \"parent\":\"{nid}.toolbar\" "
                                  f"or remove items by id")
                if k == "data" and screen.get("data"):
                    raise UIError("set would replace all demo data; use {\"op\":\"data\",\"screen\":...,\"path\":...}")
                if v is None:
                    screen.pop(k, None)
                elif k == "toolbar" and isinstance(v, list):
                    screen[k] = [self.new_node(n, nid) for n in v]
                else:
                    screen[k] = v
            self.mark(nid)
            self.summary.append(f"set {nid} " + " ".join(f"{k}={fmt_value(v, 40)}" for k, v in props.items()))
            return
        loc = self.d.find(nid)
        node = loc.node
        tmp = dict(props)
        user_set_type = "type" in tmp
        if not user_set_type:
            tmp["type"] = node.get("type")
        self.fixer.normalize_props(tmp, nid)  # fixes aliases like cornerRadius -> radius
        if not user_set_type:
            tmp.pop("type", None)
        new_type = tmp.get("type")
        if user_set_type and new_type in NODE_TYPES and new_type not in (node.get("type"), "custom"):
            # A type change keeps what the new type understands: align is mapped across
            # axes (vstack leading <-> hstack top), other props it lacks are dropped.
            allowed = COMMON_PROPS | TYPE_PROPS[new_type] | STRUCTURAL
            aligns = ALIGN_BY_TYPE["vstack"] | ALIGN_BY_TYPE["hstack"] if new_type == "scroll" \
                else ALIGN_BY_TYPE.get(new_type, ALIGN_9)
            for k in list(node):
                if k in tmp or k.startswith("_"):
                    continue
                if k not in allowed:
                    tmp[k] = None
                elif k == "align" and node[k] not in aligns:
                    swapped = {"leading": "top", "trailing": "bottom", "top": "leading", "bottom": "trailing"}.get(node[k])
                    tmp[k] = swapped if swapped in aligns else None
        for k, v in tmp.items():
            if k == "id":
                if v != nid and v in self.d.index():
                    raise UIError(f"id '{v}' is already used")
            if k in ("children",) and isinstance(v, list):
                node[k] = [self.new_node(c, nid) for c in v]
            elif k == "template" and isinstance(v, dict):
                node[k] = self.new_node(v, nid)
            elif v is None:
                node.pop(k, None)
            else:
                node[k] = v
        self.mark(node.get("id"))
        self.summary.append(f"set {nid} " + " ".join(f"{k}={fmt_value(v, 40)}" for k, v in tmp.items()))

    def op_insert(self, op: dict) -> None:
        holder, idx = self.resolve_slot(op)
        node = self.new_node(op.get("node"), self.parent_id_of_slot(holder))
        holder.insert(idx, node)
        self.mark(node["id"])
        self.summary.append(f"insert {node['id']} ({node.get('type')})")

    def op_remove(self, op: dict) -> None:
        ids = op.get("ids")
        if isinstance(ids, list):
            for one in ids:
                self.op_remove({"op": "remove", "id": one})
            return
        nid = op.get("id")
        loc = self.d.find(nid)
        if not loc.in_list:
            raise UIError(f"'{nid}' is a {'repeat template' if loc.key == 'template' else 'screen body'}; "
                          f"remove its parent or use replace")
        del loc.holder[loc.key]
        if loc.parent is not None:
            self.mark(loc.parent.get("id"))
        self.summary.append(f"remove {nid}")

    def op_move(self, op: dict) -> None:
        nid = op.get("id")
        loc = self.d.find(nid)
        if not loc.in_list:
            raise UIError(f"'{nid}' cannot be moved (it is a template or screen body)")
        ref = op.get("after", op.get("before", op.get("parent")))
        if ref == nid:
            raise UIError("cannot move an element relative to itself")
        node = loc.node
        if ref in self.d.index() and ref in subtree_ids(node):
            raise UIError(f"cannot move '{nid}' inside itself")
        del loc.holder[loc.key]
        try:
            holder, idx = self.resolve_slot(op)
        except UIError:
            loc.holder.insert(loc.key, node)
            raise
        holder.insert(idx, node)
        self.mark(nid)
        self.summary.append(f"move {nid}")

    def op_replace(self, op: dict) -> None:
        nid = op.get("id")
        loc = self.d.find(nid)
        new = op.get("node")
        if isinstance(new, dict) and "id" not in new:
            new = dict(new)
            new["id"] = nid
        node = self.new_node(new, loc.ancestors[-1] if loc.ancestors else loc.screen)
        loc.holder[loc.key] = node
        self.mark(node["id"])
        self.summary.append(f"replace {nid}")

    def op_wrap(self, op: dict) -> None:
        ids = op.get("ids") or ([op["id"]] if "id" in op else [])
        if not isinstance(ids, list) or not ids:
            raise UIError("needs \"ids\": [...]")
        locs = [self.d.find(i) for i in ids]
        holder = locs[0].holder
        if not locs[0].in_list or any(l.holder is not holder for l in locs):
            raise UIError("all ids must be siblings in the same container")
        spec = op.get("node") or {"type": "hstack"}
        if not isinstance(spec, dict):
            raise UIError("\"node\" must be an object")
        if spec.get("type") not in HAS_CHILDREN - {"button"} and spec.get("type") not in TYPE_ALIASES:
            raise UIError(f"wrap needs a container node (vstack/hstack/zstack/scroll/grid/list/section), got {compact(spec.get('type'))}")
        positions = sorted(l.key for l in locs)
        members = [holder[p] for p in positions]
        container = dict(spec)
        container.pop("children", None)
        container = self.new_node(container, self.parent_id_of_slot(holder))
        container["children"] = members
        for p in reversed(positions):
            del holder[p]
        holder.insert(positions[0], container)
        self.mark(container["id"])
        self.summary.append(f"wrap {', '.join(ids)} in {container['id']} ({container.get('type')})")

    def op_unwrap(self, op: dict) -> None:
        nid = op.get("id")
        loc = self.d.find(nid)
        if not loc.in_list:
            raise UIError(f"'{nid}' is a template or screen body; use replace")
        kids = loc.node.get("children")
        if not isinstance(kids, list):
            raise UIError(f"'{nid}' has no children to unwrap")
        loc.holder[loc.key:loc.key + 1] = kids
        if loc.parent is not None:
            self.mark(loc.parent.get("id"))
        self.summary.append(f"unwrap {nid}")

    def op_token(self, op: dict) -> None:
        path = op.get("path")
        if not isinstance(path, str):
            raise UIError("needs \"path\" like \"colors.primary\"")
        if path.startswith("tokens."):
            path = path[7:]
        set_path(self.d.tokens, path, op.get("value"), "token")
        self.mark(f"tokens.{path}")
        self.summary.append(f"token {path} = {compact(op.get('value'))}")

    def op_screen(self, op: dict) -> None:
        sid = op.get("id")
        spec = op.get("spec")
        if not isinstance(sid, str) or not ID_RE.match(sid):
            raise UIError("needs a screen \"id\" (letters, digits, -, _)")
        if spec is None:
            if "spec" not in op:  # a forgotten "spec" must not delete a whole screen
                raise UIError("needs \"spec\": {\"title\":..., \"body\":{...}} (\"spec\": null deletes the screen)")
            if sid in self.d.screens:
                del self.d.screens[sid]
                self.summary.append(f"delete screen {sid}")
                return
            raise UIError(f"screen '{sid}' does not exist")
        if not isinstance(spec, dict):
            raise UIError("\"spec\" must be a screen object")
        spec = copy.deepcopy(spec)
        spec["id"] = sid
        if sid in self.d.screens:
            # replacing a screen: its old ids are free again
            for loc in list(self.d.walk()):
                if loc.screen == sid and loc.node.get("id") in self.fixer.taken:
                    self.fixer.taken.discard(loc.node.get("id"))
        body = spec.get("body")
        if isinstance(body, dict):
            self.fixer.fix_tree(body, sid)
        elif isinstance(body, list):
            for n in body:
                self.fixer.fix_tree(n, sid)
        if isinstance(spec.get("toolbar"), list):
            for n in spec["toolbar"]:
                self.fixer.fix_tree(n, sid)
        existed = sid in self.d.screens
        self.d.screens[sid] = spec
        self.mark(sid)
        self.summary.append(f"{'replace' if existed else 'new'} screen {sid}")

    def op_nudge(self, op: dict) -> None:
        nid = op.get("id")
        prop = op.get("prop")
        by = op.get("by", 1)
        if prop not in NUDGE_PROPS:
            raise UIError(f"prop must be one of {', '.join(NUDGE_PROPS)}")
        if not isinstance(by, int) or isinstance(by, bool) or by == 0:
            raise UIError("by must be a non-zero integer (steps)")
        loc = self.d.find(nid)
        value = nudge_value(self.d, loc.node, prop, by)
        if isinstance(value, tuple) and value[0] == "controlSize":
            loc.node["controlSize"] = value[1]
            change = f"controlSize → {value[1]}"
        elif isinstance(value, tuple) and value[0] == "frame":
            loc.node.update(value[1])
            change = " ".join(f"{k} → {v}" for k, v in value[1].items())
        else:
            old = loc.node.get(prop)
            loc.node[prop] = value
            change = f"{prop} {compact(old) + '→' if old is not None else '→ '}{compact(value)}"
        self.mark(nid)
        self.summary.append(f"nudge {nid} {change}")

    def op_data(self, op: dict) -> None:
        sid = op.get("screen")
        if sid not in self.d.screens:
            raise UIError(f"needs \"screen\": one of {', '.join(sorted(self.d.screens))}")
        path = op.get("path")
        if not isinstance(path, str) or not path:
            raise UIError("needs \"path\" inside the screen's data, e.g. \"stories.0.title\"")
        if path.startswith("data."):
            path = path[5:]
        data = self.d.screens[sid].setdefault("data", {})
        set_path(data, path, op.get("value"), "data")
        self.mark(sid)
        self.summary.append(f"data {sid}.{path} = {compact(op.get('value'))[:60]}")

    def op_path(self, op: dict) -> None:
        f = op.get("file")
        path = op.get("path")
        if f in ("app", "app.json"):
            root = self.d.app
        elif f in ("tokens", "tokens.json"):
            root = self.d.tokens
        elif isinstance(f, str):
            sid = f.replace("screens/", "").replace(".json", "")
            if sid not in self.d.screens:
                raise UIError(f"no screen '{sid}'.{suggest(sid, self.d.screens)}")
            root = self.d.screens[sid]
        else:
            raise UIError("needs \"file\": \"app\" | \"tokens\" | \"screens/<id>\"")
        if not isinstance(path, str) or not path:
            raise UIError("needs \"path\" inside the file, e.g. \"tabs.0.title\"")
        set_path(root, path, op.get("value"), "path")
        self.mark(f"{f}:{path}")
        self.summary.append(f"path {f}:{path} = {compact(op.get('value'))[:60]}")


def step_scale(scale: list, current: float, by: int) -> float:
    """Moves `by` steps along a sorted scale from the nearest point to `current`."""
    if by > 0:
        bigger = [v for v in scale if v > current + 1e-9]
        return bigger[min(by, len(bigger)) - 1] if bigger else scale[-1]
    smaller = [v for v in scale if v < current - 1e-9]
    return smaller[-min(-by, len(smaller))] if smaller else scale[0]


def nudge_value(design: Design, node: dict, prop: str, by: int):
    """Next value for a relative change ("bigger", "more space"), on the design's own scales."""
    tokens = design.tokens if isinstance(design.tokens, dict) else {}
    styles = tokens.get("styles") if isinstance(tokens.get("styles"), dict) else {}
    style = styles.get(str(node.get("style", "")).lstrip("$"), {}) if node.get("style") else {}
    cur = node.get(prop, style.get(prop) if isinstance(style, dict) else None)
    font = node.get("font", style.get("font") if isinstance(style, dict) else None)
    if isinstance(font, str) and font.startswith("$"):
        font = (tokens.get("fonts") or {}).get(font[1:])
    if prop == "size" and node.get("type") == "button":
        ladder = ["mini", "small", "regular", "large", "extraLarge"]
        c = node.get("controlSize") if node.get("controlSize") in ladder else "regular"
        return ("controlSize", ladder[max(0, min(len(ladder) - 1, ladder.index(c) + by))])
    if prop == "size" and node.get("type") == "image" and "symbol" not in node:
        w, h = node.get("width"), node.get("height")
        if not isinstance(w, (int, float)) and not isinstance(h, (int, float)):
            raise UIError("image has no width/height to scale; set them first")
        out = {}
        for key, val in (("width", w), ("height", h)):
            if isinstance(val, (int, float)) and not isinstance(val, bool):
                out[key] = max(1, round(val * (1.25 ** by)))
        return ("frame", out)
    if prop == "size":
        size = cur if isinstance(cur, (int, float)) and not isinstance(cur, bool) else None
        if size is None:
            if isinstance(font, dict) and isinstance(font.get("size"), (int, float)):
                size = font["size"]
            elif isinstance(font, str):
                size = TEXT_STYLE_SIZES.get(font, 17)
            else:
                size = 17
        return step_scale(TYPE_SCALE, float(size), by)
    if prop in ("padding", "spacing", "radius"):
        group = (tokens.get("radius") if prop == "radius" else tokens.get("spacing")) or {}
        named = sorted(((v, k) for k, v in group.items() if isinstance(v, (int, float)) and v < 500))
        if isinstance(cur, dict):
            raise UIError(f"{prop} is per-edge here; use set")
        value = None
        if isinstance(cur, str) and cur.startswith("$"):
            value = group.get(cur[1:])
        elif isinstance(cur, (int, float)) and not isinstance(cur, bool):
            value = cur
        if not named:
            return max(0, (value or 0) + 4 * by)
        scale = [v for v, _ in named]
        if value is None:
            value = scale[0] - 1 if by > 0 else scale[0]
        target = step_scale(scale, float(value), by)
        return "$" + dict((v, k) for v, k in named)[target]
    if prop == "weight":
        if cur not in WEIGHT_ORDER:  # start from the font's weight, so "bolder" never lightens
            cur = font.get("weight") if isinstance(font, dict) else ("semibold" if font == "headline" else None)
        w = cur if cur in WEIGHT_ORDER else "regular"
        i = max(0, min(len(WEIGHT_ORDER) - 1, WEIGHT_ORDER.index(w) + by))
        return WEIGHT_ORDER[i]
    if prop == "opacity":
        o = cur if isinstance(cur, (int, float)) and not isinstance(cur, bool) else 1.0
        return round(max(0.0, min(1.0, o + 0.1 * by)), 2)
    if prop in ("width", "height"):
        if not isinstance(cur, (int, float)) or isinstance(cur, bool):
            raise UIError(f"{prop} has no numeric value to nudge; use set")
        return max(1, round(cur * (1.15 ** by)))
    raise UIError(f"cannot nudge '{prop}' (use one of {', '.join(NUDGE_PROPS)})")


def subtree_ids(node) -> set:
    out = set()
    stack = [node]
    while stack:
        n = stack.pop()
        if isinstance(n, dict):
            if isinstance(n.get("id"), str):
                out.add(n["id"])
            stack.extend(n.get("children") or [])
            if isinstance(n.get("template"), dict):
                stack.append(n["template"])
    return out


# --------------------------------------------------------------------------
# Live channel: rev, status, snapshots, history
# --------------------------------------------------------------------------


class Live:
    def __init__(self, project: Project):
        self.p = project
        self.dir = project.live

    def read(self, name: str):
        try:
            return read_json(self.dir / name)
        except (OSError, json.JSONDecodeError):
            return None

    def bump_rev(self, changed: list, quiet: bool = False) -> int:
        """Written after the design files; the app reloads and echoes `rev` in status.json.
        `quiet` skips the orange change outline (used when a screenshot follows)."""
        cur = self.read("rev") or {}
        rev = int(cur.get("rev", 0)) + 1
        write_atomic(self.dir / "rev", compact({"rev": rev, "changed": changed, "quiet": quiet, "at": time.time()}))
        return rev

    def status(self):
        return self.read("status.json")

    def app_alive(self, status=None) -> bool:
        status = status if status is not None else self.status()
        if not status or not isinstance(status.get("pid"), int):
            return False
        try:
            os.kill(status["pid"], 0)
            return True
        except PermissionError:
            return True
        except OSError:
            return False

    def wait_rev(self, rev: int, timeout: float = 2.5):
        """Waits until the app reports it applied `rev`. Returns (status|None, seconds)."""
        t0 = time.time()
        status = self.status()
        if not self.app_alive(status):
            return None, 0.0
        while time.time() - t0 < timeout:
            status = self.status()
            if status and int(status.get("rev", 0)) >= rev:
                return status, time.time() - t0
            time.sleep(0.025)
        return False, time.time() - t0

    # snapshots (undo) -----------------------------------------------------

    def snapshot(self, texts: dict, label: str) -> None:
        hist = self.dir / "history"
        hist.mkdir(parents=True, exist_ok=True)
        existing = sorted(int(p.name) for p in hist.iterdir() if p.name.isdigit())
        n = (existing[-1] + 1) if existing else 1
        target = hist / str(n)
        for name, text in texts.items():
            write_atomic(target / name, text)
        write_atomic(target / ".label", label)
        for old in existing[:-99]:
            shutil.rmtree(hist / str(old), ignore_errors=True)

    def latest_snapshot(self):
        hist = self.dir / "history"
        if not hist.is_dir():
            return None
        existing = sorted(int(p.name) for p in hist.iterdir() if p.name.isdigit())
        return hist / str(existing[-1]) if existing else None

    def log(self, entry: dict) -> None:
        self.dir.mkdir(parents=True, exist_ok=True)
        with (self.dir / "history.jsonl").open("a", encoding="utf-8") as f:
            f.write(compact(entry) + "\n")

    def timing(self, entry: dict) -> None:
        try:
            self.dir.mkdir(parents=True, exist_ok=True)
            with (self.dir / "timings.jsonl").open("a", encoding="utf-8") as f:
                f.write(compact(dict(entry, at=round(time.time(), 3))) + "\n")
        except OSError:
            pass

    def recent(self, n: int = 3) -> list:
        path = self.dir / "history.jsonl"
        if not path.exists():
            return []
        lines = path.read_text(encoding="utf-8").splitlines()[-n:]
        out = []
        for line in lines:
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
        return out


def restore_texts(project: Project, texts: dict) -> None:
    design = project.design
    current = {str(p.relative_to(design)) for p in design.rglob("*.json")}
    for name, text in texts.items():
        write_atomic(design / name, text)
    for name in current - set(texts):
        if name.startswith("screens/"):
            (design / name).unlink()


def write_design(project: Project, design: Design) -> list:
    changes = design.changed_files()
    for name, text in changes["write"].items():
        write_atomic(project.design / name, text)
    for name in changes["remove"]:
        try:
            (project.design / name).unlink()
        except FileNotFoundError:
            pass
    return list(changes["write"]) + changes["remove"]


def privacy_hint(root: Path) -> str:
    home = Path.home()
    for name in ("Documents", "Desktop", "Downloads"):
        try:
            root.relative_to(home / name)
            return (f" The project is inside ~/{name}; macOS privacy rules can stop the Simulator from reading it. "
                    f"Move it to e.g. ~/Code.")
        except ValueError:
            continue
    return ""


# --------------------------------------------------------------------------
# Apply pipeline (shared by apply / ask / undo / variants)
# --------------------------------------------------------------------------


def run_ops(project: Project, ops: list, note: str = "", wait: bool = True, shot: bool = False,
            quiet: bool = False, record: bool = True, start_texts=None, snapshot: bool = True) -> dict:
    """Validate + apply ops in memory, write changed files atomically, bump the rev
    and wait for the app to confirm. `start_texts` applies the ops on top of that
    content instead of the files on disk (used to switch variants in one write)."""
    t0 = time.time()
    with project_lock(project):
        return _run_ops_locked(project, ops, note, wait, shot, quiet, record, start_texts, snapshot, t0)


class project_lock:
    """Serializes applies (a person and a model, or parallel variants) via flock."""

    def __init__(self, project: Project):
        self.path = project.live / "lock"
        self.fh = None

    def __enter__(self):
        try:
            import fcntl

            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.fh = self.path.open("w")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        except (ImportError, OSError):
            self.fh = None
        return self

    def __exit__(self, *exc):
        if self.fh is not None:
            self.fh.close()


def _run_ops_locked(project, ops, note, wait, shot, quiet, record, start_texts, snapshot, t0) -> dict:
    design = Design(project)
    if design.load_errors:
        raise UIError("design files are broken, fix them first:\n  " + "\n  ".join(design.load_errors))
    before = design.raw_texts()
    if start_texts is not None:
        design.load_texts(start_texts)
    applier = Applier(design)
    applier.apply_all(ops)
    v = Validator(design).run()
    if v.errors:
        raise UIError("rejected, nothing was written:\n  " + "\n  ".join(v.errors[:12]) +
                      (f"\n  … {len(v.errors) - 12} more" if len(v.errors) > 12 else ""))
    live = Live(project)
    files = []
    pending = design.changed_files()
    if pending["write"] or pending["remove"]:
        if snapshot:
            live.snapshot(before, note or ", ".join(applier.summary)[:200])
        files = write_design(project, design)
    rev = live.bump_rev(applier.changed, quiet=shot)
    write_ms = (time.time() - t0) * 1000
    if record:
        live.log({"at": time.time(), "request": note, "ops": applier.summary, "changed": applier.changed})
    result = {"summary": applier.summary, "changed": applier.changed, "notes": applier.fixer.notes,
              "warnings": v.warnings, "files": files, "rev": rev, "write_ms": write_ms, "status": None}
    if wait:
        status, secs = live.wait_rev(rev)
        result["status"] = status
        result["render_s"] = secs
    st = result.get("status")
    write_atomic(live.dir / "last-apply.json", compact({
        "at": time.time(), "say": note, "summary": applier.summary[:8], "notes": applier.fixer.notes[:6],
        "warnings": v.warnings[:4], "screen": st.get("screen") if isinstance(st, dict) else None,
        "app": "live" if isinstance(st, dict) else ("down" if st is None else "unconfirmed"),
        "error": st.get("error") if isinstance(st, dict) else None,
        "seconds": round(write_ms / 1000 + (result.get("render_s") or 0), 2)}))
    if shot and result.get("status"):
        time.sleep(0.35)  # let the 0.25 s change animation finish
        result["shot"] = take_screenshot(project)
    if not quiet:
        print_result(project, result)
    return result


def print_result(project: Project, r: dict) -> None:
    what = "; ".join(r["summary"]) or "no changes"
    print(f"ok  {what}")
    for n in r["notes"]:
        print(f"    auto-fixed {n}")
    for w in r["warnings"][:5]:
        print(f"    note: {w}")
    st = r.get("status")
    if st is None and "render_s" in r:
        print(f"    app not running — files saved; start it with ./run.sh.{privacy_hint(project.root)}")
    elif st is False:
        print(f"    saved, but the app didn't confirm within {r['render_s']:.1f}s.{privacy_hint(project.root)}")
    elif isinstance(st, dict):
        err = st.get("error")
        if err:
            print(f"    app reports a design error: {err}")
        else:
            print(f"    live on '{st.get('screen')}' in {r['write_ms'] / 1000 + r['render_s']:.2f}s")
    if r.get("shot"):
        print(f"    screenshot: {r['shot']}")


def take_screenshot(project: Project, path=None, small: bool = False) -> str:
    out = Path(path) if path else project.live / "shot.png"
    out.parent.mkdir(parents=True, exist_ok=True)
    device = "booted"
    dev_file = project.live / "device"
    if dev_file.exists():
        device = dev_file.read_text().strip() or "booted"
    try:
        subprocess.run(["xcrun", "simctl", "io", device, "screenshot", str(out)], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=20)
    except FileNotFoundError:
        raise UIError("xcrun not found (screenshots need Xcode on this Mac)")
    except subprocess.CalledProcessError as e:
        raise UIError(f"screenshot failed: {e.stderr.decode(errors='replace').strip()}")
    except subprocess.TimeoutExpired:
        raise UIError("screenshot timed out (is the Simulator window open?)")
    if small and shutil.which("sips"):
        jpg = out.with_suffix(".jpg")
        done = subprocess.run(["sips", "-Z", "900", "-s", "format", "jpeg", "-s", "formatOptions", "70",
                               str(out), "--out", str(jpg)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if done.returncode == 0:
            return str(jpg)
    return str(out)


