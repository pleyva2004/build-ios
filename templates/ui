HEREDOC_FIRST = re.compile(r"^\./ui (apply|context|undo|status|shot|pick|validate|stats|reference|next|prev|keep)"
                           r"((?: [A-Za-z0-9_.@/=-]+)*)(?: <<'([A-Z]{2,10})')?$")


def inert_ui_command(cmd: str) -> bool:
    """True for `./ui <cmd> [simple args]` optionally followed by a quoted heredoc whose
    body (inert data: quoted heredocs are not expanded) ends at the very last line."""
    lines = cmd.rstrip("\n").split("\n")
    # The first line must be printable ASCII: \r, \v, \f, NBSP etc. would stay in bash's
    # delimiter word ('OPS'\r ends at "OPS\r") and let a later line run as a command.
    if any(not (" " <= ch <= "~") and ch != "\t" for ch in lines[0]):
        return False
    m = HEREDOC_FIRST.match(lines[0].strip(" \t"))
    if not m:
        return False
    delim = m.group(3)
    if delim is None:
        return len(lines) == 1
    if len(lines) < 2 or lines[-1] != delim:
        return False
    return all(line != delim for line in lines[1:-1])


def cmd_hook(project: Project, args) -> int:
    """One entry point for Claude Code hooks (fast, never blocks on errors):
    UserPromptSubmit -> adds the live UI context; PreToolUse(Bash) -> allows inert
    `./ui ...` heredoc commands without a prompt; PostToolUse(Edit/Write) ->
    validates design JSON (exit 2 = tell the model); PostToolUse(Bash) -> ends the
    turn after a successful `./ui apply --end-turn` (no second model call)."""
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        return 0
    event = payload.get("hook_event_name")
    tool = payload.get("tool_name")
    ti = payload.get("tool_input") or {}
    if event == "UserPromptSubmit":
        prompt = str(payload.get("prompt", "")).lstrip()
        # The hook owns context for plain prompts and /ui (cwd-independent, includes
        # text->id mentions); other slash commands get nothing.
        if os.environ.get("UI_NO_CONTEXT_HOOK") or (prompt.startswith("/") and not re.match(r"/ui\b", prompt)):
            return 0  # slash commands (e.g. /ui) inject their own context
        try:
            ctx = build_context(project, request=str(payload.get("prompt", ""))[:500])
        except Exception:
            return 0
        print(f"<ui-context note=\"live state of the prototype; UI edits go through ./ui apply\">\n{ctx}\n</ui-context>")
        return 0
    if event == "PreToolUse" and tool == "Bash":
        if inert_ui_command(str(ti.get("command", ""))):
            print(compact({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow",
                                                  "permissionDecisionReason": "./ui with inert heredoc"}}))
        return 0
    if event == "PostToolUse" and tool in ("Edit", "Write", "MultiEdit"):
        return cmd_validate(project, argparse.Namespace(hook=True, hook_payload=payload))
    if event == "PostToolUseFailure" and tool == "Bash":
        # /ui escalation (ops: [] -> exit 3) also ends the turn; other failures don't,
        # so the model can still fix rejected ops and retry once.
        first = str(ti.get("command", "")).split("\n")[0]
        err = str(payload.get("error", "")) + str(payload.get("tool_response", ""))
        if first.startswith("./ui apply") and "--end-turn" in first and "ESCALATE:" in err:
            line = next((l for l in err.splitlines() if "ESCALATE:" in l), "ESCALATE")
            msg = line[line.index("ESCALATE:"):].strip()
            print(compact({"continue": False, "stopReason": f"{msg} (needs a Swift component — see CLAUDE.md)"}))
        return 0
    if event == "PostToolUse" and tool == "Bash":
        first = str(ti.get("command", "")).split("\n")[0]
        if first.startswith("./ui apply") and "--end-turn" in first:
            info = Live(project).read("last-apply.json") or {}
            if not info or time.time() - float(info.get("at", 0)) > 60:
                return 0
            where = {"live": f"live on '{info.get('screen')}' in {info.get('seconds')}s",
                     "down": "saved — app not running (./run.sh)",
                     "unconfirmed": "saved — app didn't confirm"}.get(info.get("app"), "")
            msg = f"✓ {info.get('say') or '; '.join(info.get('summary') or [])} · {where}"
            if info.get("error"):
                msg += f" · app error: {info['error']}"
            print(compact({"continue": False, "stopReason": msg}))
        return 0
    return 0


