def cmd_stats(project: Project, args) -> int:
    path = project.live / "timings.jsonl"
    if not path.exists():
        print("no timings yet")
        return 1
    rows = []
    for line in path.read_text(encoding="utf-8").splitlines()[-500:]:
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            pass

    def pct(vals, q):
        vals = sorted(vals)
        return vals[min(len(vals) - 1, int(q * len(vals)))] if vals else 0

    for kind in ("ask", "variants", "apply", "tune"):
        rs = [r for r in rows if r.get("kind") == kind]
        if not rs:
            continue
        parts = [f"{kind:<9} n={len(rs):<4}"]
        for field in ("model_s", "first_s", "write_s", "render_s"):
            vals = [r[field] for r in rs if isinstance(r.get(field), (int, float))]
            if vals:
                parts.append(f"{field} p50 {pct(vals, .5):.2f} p90 {pct(vals, .9):.2f}")
        cached = [r.get("tok_cache_read", 0) for r in rs if "tok_in" in r]
        if cached:
            parts.append(f"cache hits {sum(1 for c in cached if c)}/{len(cached)}")
        print("  ".join(parts))
    return 0


TUNE_KEYS = [
    ("+", "size", 1), ("-", "size", -1), ("]", "padding", 1), ("[", "padding", -1),
    ("}", "spacing", 1), ("{", "spacing", -1), ("r", "radius", 1), ("R", "radius", -1),
    ("w", "weight", 1), ("W", "weight", -1), ("o", "opacity", -1), ("O", "opacity", 1),
]
TUNE_HELP = ("+/- size  ]/[ padding  }/{ spacing  r/R radius  w/W weight  o/O opacity  "
             "c fg color  b bg color  s style  v variant  u undo  p pick  q quit")


def cycle(options: list, current):
    if not options:
        raise UIError("nothing to cycle through")
    if current in options:
        return options[(options.index(current) + 1) % len(options)]
    return options[0]


def tune_op(project: Project, nid: str, key: str):
    for k, prop, by in TUNE_KEYS:
        if key == k:
            return {"op": "nudge", "id": nid, "prop": prop, "by": by}
    d = Design(project)
    node = d.find(nid).node
    tokens = d.tokens if isinstance(d.tokens, dict) else {}
    colors = ["$" + c for c in (tokens.get("colors") or {})]
    if key == "c":
        return {"op": "set", "id": nid, "props": {"foreground": cycle(colors, node.get("foreground"))}}
    if key == "b":
        return {"op": "set", "id": nid, "props": {"background": cycle(colors, node.get("background"))}}
    if key == "s":
        styles = list((tokens.get("styles") or {}))
        return {"op": "set", "id": nid, "props": {"style": cycle(styles, node.get("style"))}}
    if key == "v":
        if node.get("type") != "button":
            raise UIError("v cycles button variants; pick a button")
        order = ["primary", "secondary", "glassProminent", "glass", "borderless", "plain"]
        return {"op": "set", "id": nid, "props": {"variant": cycle(order, node.get("variant"))}}
    return None


def read_key() -> str:
    import termios
    import tty

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def cmd_tune(project: Project, args) -> int:
    live = Live(project)
    nid = args.id
    if not nid:
        sel = live.read("selection.json") or {}
        nid = sel.get("id")
    if not nid:
        if cmd_pick(project, argparse.Namespace(timeout=120)) != 0:
            return 1
        nid = (live.read("selection.json") or {}).get("id")
    Design(project).find(nid)
    print(f"tuning {nid}   {TUNE_HELP}")
    changes = []
    while True:
        try:
            key = read_key()
        except (EOFError, KeyboardInterrupt):
            key = "q"
        if key in ("q", "\x03", "\x1b"):
            break
        try:
            if key == "u":
                cmd_undo(project, argparse.Namespace(steps=1))
                continue
            if key == "p":
                if cmd_pick(project, argparse.Namespace(timeout=120)) == 0:
                    nid = (live.read("selection.json") or {}).get("id") or nid
                    print(f"tuning {nid}")
                continue
            op = tune_op(project, nid, key)
            if op is None:
                continue
            t0 = time.time()
            res = run_ops(project, [op], wait=False, quiet=True, record=False)
            live.timing({"kind": "tune", "write_s": round(time.time() - t0, 3)})
            changes.append(op.get("prop") or ",".join(op.get("props", {})))
            print(f"ok  {'; '.join(res['summary'])}")
        except UIError as e:
            print(f"error {e}")
    if changes:
        live.log({"at": time.time(), "request": f"(tuned {nid} by hand)", "ops": [f"tune {nid}: {', '.join(sorted(set(changes)))}"],
                  "changed": [nid]})
    return 0


