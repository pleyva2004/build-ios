def _node_by_id(design: Design, nid: str):
    loc = design.index().get(nid)
    return loc


def _check(design: Design, base: Design, exp: dict, escalated: bool) -> str:
    """Returns "" when the expectation holds, else a short reason."""
    if "escalate" in exp:
        return "" if escalated == bool(exp["escalate"]) else f"escalate={escalated}"
    if escalated:
        return "escalated"
    if "token" in exp:
        now, was = resolve_path(design.tokens, exp["token"]), resolve_path(base.tokens, exp["token"])
        if "changed" in exp:
            return "" if (now != was) == exp["changed"] else f"token {exp['token']} changed={now != was}"
        return "" if now == exp.get("eq") else f"token {exp['token']}={compact(now)}"
    if "data" in exp:
        sid, path = exp["data"].split(":", 1)
        val = resolve_path(design.screens.get(sid, {}).get("data", {}), path)
        return "" if val == exp.get("eq") else f"data {exp['data']}={compact(val)}"
    if "app" in exp:
        val = resolve_path(design.app, exp["app"])
        return "" if val == exp.get("eq") else f"app {exp['app']}={compact(val)}"
    if "screen_exists" in exp:
        return "" if exp["screen_exists"] in design.screens else f"no screen {exp['screen_exists']}"
    if "toolbar_count" in exp:
        n = len(design.screens.get(exp["toolbar_count"], {}).get("toolbar") or [])
        return "" if n >= exp.get("gte", 1) else f"toolbar has {n}"
    if "text_exists" in exp:
        for loc in design.walk():
            if loc.screen == exp.get("screen", loc.screen) and exp["text_exists"] in str(loc.node.get("text", "")):
                return ""
        return f"no text {exp['text_exists']!r}"
    if "text_exists_any_type" in exp:
        for loc in design.walk():
            if loc.screen == exp.get("screen", loc.screen) and loc.node.get("type") == exp["text_exists_any_type"] \
                    and loc.node.get("axis") == "horizontal":
                return ""
        return f"no horizontal {exp['text_exists_any_type']}"
    nid = exp.get("id")
    loc = _node_by_id(design, nid) if nid else None
    if "exists" in exp:
        return "" if (loc is not None) == exp["exists"] else f"{nid} exists={loc is not None}"
    if loc is None:
        return f"{nid} missing"
    node = loc.node
    if exp.get("unchanged"):
        old = _node_by_id(base, nid)
        return "" if old is not None and old.node == node else f"{nid} changed"
    if "parent_type" in exp:
        ptype = loc.parent.get("type") if loc.parent else None
        return "" if ptype == exp["parent_type"] else f"{nid} parent is {ptype}"
    if exp.get("hidden"):
        if node.get("visibleIf") or node.get("opacity") == 0:
            return ""
        return f"{nid} still visible"
    prop = exp.get("prop")
    val = node.get(prop)
    if "eq" in exp:
        return "" if val == exp["eq"] else f"{nid}.{prop}={compact(val)}"
    if "in" in exp:
        return "" if val in exp["in"] else f"{nid}.{prop}={compact(val)}"
    if "gt" in exp:
        return "" if isinstance(val, (int, float)) and val > exp["gt"] else f"{nid}.{prop}={compact(val)}"
    if "changed" in exp:
        old = _node_by_id(base, nid)
        was = old.node.get(prop) if old else None
        return "" if (val != was) == exp["changed"] else f"{nid}.{prop} unchanged ({compact(val)})"
    return "unknown expectation"


def cmd_eval(project: Project, args) -> int:
    """Runs tools/evals.jsonl against throwaway copies of design/ and reports
    first-try validity, pass rate and latency. Costs one model call per case."""
    import tempfile

    cases_path = Path(args.file) if args.file else project.root / "tools" / "evals.jsonl"
    if not cases_path.exists():
        raise UIError(f"no eval cases at {cases_path}")
    cases = [json.loads(l) for l in cases_path.read_text(encoding="utf-8").splitlines() if l.strip()]
    if args.only:
        cases = [c for c in cases if args.only.lower() in c.get("name", "").lower()]
    backend = make_backend(project, args.model, args.think)
    results = []
    for case in cases:
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            shutil.copytree(project.design, root / "design")
            (root / "tools").mkdir()
            if project.reference.exists():
                shutil.copy(project.reference, root / "tools" / "REFERENCE.md")
            sub = Project(root)
            if case.get("setup"):
                run_ops(sub, case["setup"], note=case.get("history", ""), wait=False, quiet=True)
            if case.get("select"):
                write_atomic(sub.live / "selection.json", compact({"id": case["select"], "at": time.time() + 1}))
            base = Design(sub)
            t0 = time.time()
            escalated, error, first_try = False, "", True
            try:
                context = build_context(sub, request=case["request"])
                system = system_prompt(sub)
                calls = []

                class Counting(Backend):
                    name, model = backend.name, backend.model

                    def complete(self, s, m, n):
                        calls.append(1)
                        return backend.complete(s, m, n)

                ops, say, _ = request_ops(sub, Counting(), context, system, case["request"])
                first_try = len(calls) == 1
                if ops:
                    run_ops(sub, ops, note=case["request"], wait=False, quiet=True)
                else:
                    escalated = True
            except UIError as e:
                error = str(e)[:160]
            secs = time.time() - t0
            after = Design(sub)
            fails = [] if error else [r for r in (_check(after, base, exp, escalated) for exp in case["expect"]) if r]
            ok = not error and not fails
            results.append({"name": case.get("name"), "ok": ok, "first_try": first_try and not error,
                            "secs": round(secs, 2), "why": error or "; ".join(fails)})
            mark = "PASS" if ok else "FAIL"
            print(f"{mark}  {secs:5.2f}s  {case.get('name')}" + ("" if ok else f"   — {results[-1]['why']}"))
    n = len(results) or 1
    secs = sorted(r["secs"] for r in results)
    p = lambda q: secs[min(len(secs) - 1, int(q * len(secs)))] if secs else 0
    print(f"\npass {sum(r['ok'] for r in results)}/{len(results)}  ·  valid first try "
          f"{sum(r['first_try'] for r in results)}/{len(results)}  ·  latency p50 {p(.5):.2f}s p90 {p(.9):.2f}s"
          f"  ·  {backend.name} {backend.model}")
    write_atomic(project.live / "eval-last.json", dump(results))
    return 0 if all(r["ok"] for r in results) else 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="ui", description="Live UI engine: edit design/*.json fast and safely.",
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog="\n\n".join(__doc__.split("\n\n")[1:3]))
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("context", help="compact map of the current screen for a model")
    s.add_argument("--screen", help="screen id (default: what the Simulator shows)")
    s.add_argument("--request", default="", help="the user's request (adds text→id matches)")

    s = sub.add_parser("apply", help="apply ops JSON (argument, @file, or stdin)")
    s.add_argument("ops", nargs="?")
    s.add_argument("--shot", action="store_true", help="screenshot after the app renders")
    s.add_argument("--no-wait", action="store_true", help="don't wait for the app to confirm")
    s.add_argument("--note", help="what was asked (kept in history for follow-ups)")
    s.add_argument("--end-turn", action="store_true", help="(read by the Claude Code hook) end the turn on success")

    s = sub.add_parser("undo", help="revert the last apply")
    s.add_argument("steps", nargs="?", type=int, default=1)

    s = sub.add_parser("pick", help="tap an element in the Simulator to get its id")
    s.add_argument("--timeout", type=float, default=120)

    sub.add_parser("status", help="what the running app is showing")

    s = sub.add_parser("shot", help="Simulator screenshot")
    s.add_argument("path", nargs="?")
    s.add_argument("--small", action="store_true", help="also write a ~900px JPEG (for phones / model context)")

    sub.add_parser("stats", help="latency percentiles from .live/timings.jsonl")

    s = sub.add_parser("tune", help="no-model fast lane: single keys nudge the picked element")
    s.add_argument("id", nargs="?")

    s = sub.add_parser("validate", help="check design/*.json")
    s.add_argument("--hook", action="store_true", help="Claude Code PostToolUse hook mode (exit 2 on errors)")

    sub.add_parser("reference", help="print the ops / node reference")
    sub.add_parser("hook", help="Claude Code hook entry point (reads hook JSON on stdin)")

    s = sub.add_parser("eval", help="measure model accuracy + latency on tools/evals.jsonl (one call per case)")
    s.add_argument("--file", help="cases file (default tools/evals.jsonl)")
    s.add_argument("--only", help="run cases whose name contains this text")
    s.add_argument("--model", default=os.environ.get("UI_MODEL", DEFAULT_MODEL))
    s.add_argument("--think", action="store_true")

    for name in ("ask", "chat"):
        s = sub.add_parser(name, help="one model call -> ops -> applied" if name == "ask" else "interactive loop")
        if name == "ask":
            s.add_argument("request", nargs="*")
            s.add_argument("-n", type=int, default=1, help="number of variants to generate")
            s.add_argument("--dry-run", action="store_true", help="print ops without applying")
            s.add_argument("--shot", action="store_true", help="screenshot after the app renders")
        s.add_argument("--model", default=os.environ.get("UI_MODEL", DEFAULT_MODEL))
        s.add_argument("--think", action="store_true", help="let the model think first (slower, for big changes)")

    for name in ("next", "prev"):
        s = sub.add_parser(name, help=f"show the {name} variant")
        s.add_argument("--shot", action="store_true")
    sub.add_parser("keep", help="keep the variant on screen")
    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help()
        return 0
    project = Project(find_project())
    if not project.design.exists() and args.cmd not in ("reference",):
        print(f"error no design/ folder found (looked in {project.root})", file=sys.stderr)
        return 1
    handlers = {
        "context": cmd_context, "apply": cmd_apply, "undo": cmd_undo, "pick": cmd_pick, "status": cmd_status,
        "shot": cmd_shot, "validate": cmd_validate, "reference": cmd_reference, "ask": cmd_ask, "chat": cmd_chat,
        "keep": cmd_keep, "stats": cmd_stats, "tune": cmd_tune, "hook": cmd_hook, "eval": cmd_eval,
        "next": lambda pr, a: cmd_variant_step(pr, a, 1),
        "prev": lambda pr, a: cmd_variant_step(pr, a, -1),
    }
    try:
        return handlers[args.cmd](project, args)
    except Escalate as e:
        print(f"ESCALATE: {e}\n  (not expressible in design JSON: add a Swift view in Sources/Components, "
              f"register it, ./run.sh once, then place it with a custom node)")
        return 3
    except UIError as e:
        print(f"error {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
