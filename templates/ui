class Design:
    """In-memory copy of design/*.json. Ops mutate it; save() writes changes."""

    def __init__(self, project: Project):
        self.project = project
        self.app: dict = {}
        self.tokens: dict = {}
        self.screens: dict = {}
        self.load_errors: list = []
        self._original: dict = {}
        self.load()

    def load(self) -> None:
        d = self.project.design
        self._raw = {}
        self.app = self._read(d / "app.json", "app.json", required=True)
        self.tokens = self._read(d / "tokens.json", "tokens.json", required=False)
        self.screens = {}
        sdir = d / "screens"
        if sdir.is_dir():
            for p in sorted(sdir.glob("*.json")):
                if p.name.startswith("."):
                    continue
                errors_before = len(self.load_errors)
                data = self._read(p, f"screens/{p.name}", required=True)
                if isinstance(data, dict) and len(self.load_errors) == errors_before:
                    self.screens[p.stem] = data
        self._original = self.snapshot_texts()

    def load_texts(self, texts: dict) -> None:
        """Replace the in-memory content (keeps the on-disk original for diffing)."""
        self.app = json.loads(texts.get("app.json", "{}"))
        self.tokens = json.loads(texts.get("tokens.json", "{}"))
        self.screens = {}
        for name, text in sorted(texts.items()):
            if name.startswith("screens/") and name.endswith(".json"):
                self.screens[name[len("screens/"):-5]] = json.loads(text)

    def _read(self, path: Path, label: str, required: bool):
        if not path.exists():
            if required:
                self.load_errors.append(f"{label}: missing")
            return {}
        try:
            text = path.read_text(encoding="utf-8")
            data = json.loads(text)
            self._raw[label] = text
        except json.JSONDecodeError as e:
            self.load_errors.append(f"{label}: invalid JSON (line {e.lineno}, col {e.colno}): {e.msg}")
            return {}
        if not isinstance(data, dict):
            self.load_errors.append(f"{label}: top level must be an object")
            return {}
        return data

    # files ------------------------------------------------------------

    def file_map(self) -> dict:
        out = {"app.json": self.app, "tokens.json": self.tokens}
        for sid, s in self.screens.items():
            out[f"screens/{sid}.json"] = s
        return out

    def snapshot_texts(self) -> dict:
        return {name: dump(obj) for name, obj in self.file_map().items()}

    def raw_texts(self) -> dict:
        """The files as loaded, byte for byte (undo snapshots), before any op ran."""
        return {name: self._raw.get(name, dump(obj)) for name, obj in self.file_map().items()}

    def changed_files(self) -> dict:
        now = self.snapshot_texts()
        changed = {k: v for k, v in now.items() if self._original.get(k) != v}
        removed = [k for k in self._original if k not in now]
        return {"write": changed, "remove": removed}

    # tree walking -----------------------------------------------------

    def walk(self):
        """Yields Loc for every node (screens' body trees, templates, toolbar items)."""
        for sid in sorted(self.screens):
            screen = self.screens[sid]
            body = screen.get("body")
            if isinstance(body, dict):
                yield from self._walk_node(sid, body, screen, "body", None, [])
            elif isinstance(body, list):
                for i, n in enumerate(body):
                    if isinstance(n, dict):
                        yield from self._walk_node(sid, n, body, i, None, [])
            tb = screen.get("toolbar")
            if isinstance(tb, list):
                for i, n in enumerate(tb):
                    if isinstance(n, dict):
                        yield from self._walk_node(sid, n, tb, i, None, [])

    def _walk_node(self, sid, node, holder, key, parent, ancestors):
        loc = Loc(sid, node, holder, key, parent, list(ancestors))
        yield loc
        nid = node.get("id")
        anc = ancestors + ([nid] if nid else [])
        kids = node.get("children")
        if isinstance(kids, list):
            for i, c in enumerate(kids):
                if isinstance(c, dict):
                    yield from self._walk_node(sid, c, kids, i, node, anc)
        tmpl = node.get("template")
        if isinstance(tmpl, dict):
            yield from self._walk_node(sid, tmpl, node, "template", node, anc)

    def index(self) -> dict:
        idx = {}
        for loc in self.walk():
            nid = loc.node.get("id")
            if isinstance(nid, str) and nid not in idx:
                idx[nid] = loc
        return idx

    def all_ids(self) -> list:
        return [loc.node.get("id") for loc in self.walk() if isinstance(loc.node.get("id"), str)]

    def find(self, nid) -> "Loc":
        if not isinstance(nid, str) or not nid:
            raise UIError(f"expected a node id, got {compact(nid)}")
        loc = self.index().get(nid)
        if loc is None:
            raise UIError(f"no element with id '{nid}'.{suggest(nid, self.all_ids() + list(self.screens))}")
        return loc

    def tab_screens(self) -> list:
        tabs = self.app.get("tabs")
        if isinstance(tabs, list):
            return [t.get("screen") or t.get("id") for t in tabs if isinstance(t, dict)]
        return []

    def default_screen(self) -> str:
        tabs = self.tab_screens()
        if tabs:
            return tabs[0]
        root = self.app.get("root")
        if isinstance(root, str):
            return root
        return sorted(self.screens)[0] if self.screens else ""


class Loc:
    __slots__ = ("screen", "node", "holder", "key", "parent", "ancestors")

    def __init__(self, screen, node, holder, key, parent, ancestors):
        self.screen = screen
        self.node = node
        self.holder = holder  # list (children/toolbar/body list) or dict (repeat node / screen)
        self.key = key  # index into list, or "template" / "body"
        self.parent = parent  # parent node dict or None
        self.ancestors = ancestors

    @property
    def in_list(self) -> bool:
        return isinstance(self.holder, list)


def suggest(word: str, candidates) -> str:
    cands = [c for c in candidates if isinstance(c, str)]
    close = difflib.get_close_matches(word, cands, n=3, cutoff=0.6)
    return f" Did you mean {', '.join(close)}?" if close else ""


