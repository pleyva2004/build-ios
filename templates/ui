def cmd_undo(project: Project, args) -> int:
    live = Live(project)
    for _ in range(max(1, args.steps)):
        snap = live.latest_snapshot()
        if snap is None:
            print("nothing to undo")
            return 1
        texts = {}
        for p in snap.rglob("*.json"):
            texts[str(p.relative_to(snap))] = p.read_text(encoding="utf-8")
        label = (snap / ".label").read_text(encoding="utf-8") if (snap / ".label").exists() else ""
        restore_texts(project, texts)
        shutil.rmtree(snap, ignore_errors=True)
        print(f"ok  undid: {label}")
    try:
        (live.dir / "variants.json").unlink()
    except FileNotFoundError:
        pass
    rev = live.bump_rev([])
    live.wait_rev(rev, 1.5)
    return 0


