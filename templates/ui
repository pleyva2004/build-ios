SYSTEM_RULES = """You edit the UI of a SwiftUI prototype app. The UI is JSON (design/*.json) and the
running app hot-reloads it. You never write Swift. You answer with ONE JSON object and nothing else:

  {"say": "<= 12 words: what you will change", "ops": [ ...ops... ]}

Rules:
- Use only the ops, node types and props in the reference below. Ids you reference must exist in
  the context. New nodes may omit "id".
- Pick the narrowest op. A change to "all buttons/cards/the brand" is a token or style edit. A change
  to one element is a "set". Layout changes use wrap/move/insert/unwrap.
- "it", "this", "that" mean the FOCUS element in the context; otherwise the most likely element on the
  screen being shown (say which one you picked).
- Scope: one element → set/nudge; "all cards/buttons" → its style (token op on styles.*); brand/theme →
  a color token. Relative requests (bigger, more, less, again) → nudge.
- Stay consistent with the design tokens; prefer $tokens over raw values; add a token when introducing
  a new brand color.
- If the request cannot be done with these tools, return {"ops": [], "say": "<why, and what Swift
  component would be needed>"}.
"""

VARIANTS_RULES = """Return {N} clearly different design directions as:
  {"variants": [{"name": "<2-4 words>", "ops": [...]}, ...]}
Each variant must be a complete, independent set of ops applied to the CURRENT design (not cumulative)."""


def system_prompt(project: Project) -> str:
    ref = project.reference.read_text(encoding="utf-8") if project.reference.exists() else ""
    return SYSTEM_RULES + "\n\n# Reference\n\n" + ref


def user_prompt(context: str, request: str, variants: int) -> str:
    tail = VARIANTS_RULES.replace("{N}", str(variants)) if variants > 1 else ""
    return f"<context>\n{context}\n</context>\n\nRequest: {request}\n{tail}".rstrip()


class Backend:
    name = "?"
    model = ""
    last_usage: dict = {}

    def warm(self, system: str) -> None:
        pass

    def complete(self, system: str, messages: list, max_tokens: int) -> str:
        raise NotImplementedError


class APIBackend(Backend):
    """Official anthropic SDK. One client per process so chat reuses the connection."""

    name = "api"

    def __init__(self, model: str, think: bool):
        import anthropic  # noqa: F401  (ImportError handled by caller)

        self.anthropic = anthropic
        self.client = anthropic.Anthropic(max_retries=1, timeout=60.0)
        self.model = model
        self.think = think
        self.last_usage = {}

    def _kwargs(self, system: str, messages: list, max_tokens: int) -> dict:
        kwargs = dict(
            model=self.model,
            max_tokens=max_tokens,
            # Static prefix (rules + reference) is cached; the context/request follow it.
            system=[{"type": "text", "text": system, "cache_control": {"type": "ephemeral", "ttl": "1h"}}],
            messages=messages,
        )
        if self.think:
            kwargs["thinking"] = {"type": "adaptive"}
            kwargs["output_config"] = {"effort": "medium"}
        elif "haiku" in self.model:
            # Thinking off + low effort: the fastest time-to-first-op for small edits.
            kwargs["thinking"] = {"type": "disabled"}
            kwargs["output_config"] = {"effort": "low"}
        else:
            # Larger models: thinking can't always be disabled; low effort keeps it short.
            kwargs["output_config"] = {"effort": "low"}
        return kwargs

    def warm(self, system: str) -> None:
        """Pre-writes the prompt cache (max_tokens=0) so the first real request is fast."""
        try:
            self.client.messages.create(**self._kwargs(system, [{"role": "user", "content": "warmup"}], 0))
        except Exception:  # best effort
            pass

    def complete(self, system: str, messages: list, max_tokens: int) -> str:
        a = self.anthropic
        kwargs = self._kwargs(system, messages, max_tokens)
        try:
            resp = self.client.messages.create(**kwargs)
        except a.AuthenticationError:
            raise UIError("Claude API rejected the credentials. Set ANTHROPIC_API_KEY (or run `ant auth login`), "
                          "or use UI_BACKEND=claude to go through Claude Code.")
        except a.RateLimitError:
            raise UIError("Claude API rate limit hit; try again in a moment.")
        except a.BadRequestError as e:
            raise UIError(f"Claude API rejected the request: {e.message}")
        except a.APIStatusError as e:
            raise UIError(f"Claude API error {e.status_code}: {e.message}")
        except a.APIConnectionError:
            raise UIError("cannot reach the Claude API (network?)")
        except a.AnthropicError as e:
            raise UIError(f"Claude API client error: {e}. Set ANTHROPIC_API_KEY or use UI_BACKEND=claude.")
        except TypeError as e:
            raise UIError(f"the installed anthropic SDK is too old ({e}); install uv (`brew install uv`) "
                          f"so ./ui can run with a current SDK")
        u = getattr(resp, "usage", None)
        if u is not None:
            self.last_usage = {"in": getattr(u, "input_tokens", 0), "out": getattr(u, "output_tokens", 0),
                               "cache_read": getattr(u, "cache_read_input_tokens", 0) or 0}
        if resp.stop_reason == "refusal":
            raise UIError("the model declined this request")
        text = "".join(b.text for b in resp.content if getattr(b, "type", "") == "text")
        if resp.stop_reason == "max_tokens":
            raise UIError("the model ran out of output tokens; ask for a smaller change")
        return text


class ClaudeCLIBackend(Backend):
    """Falls back to Claude Code's headless mode (uses your Claude Code login)."""

    name = "claude-cli"

    def __init__(self, project: Project, model: str):
        self.project = project
        self.model = "haiku" if model == DEFAULT_MODEL else model

    def complete(self, system: str, messages: list, max_tokens: int) -> str:
        sys_file = self.project.live / "ask-system.md"
        write_atomic(sys_file, system)
        prompt = "\n\n".join(
            (m["content"] if m["role"] == "user" else f"(your previous answer)\n{m['content']}") for m in messages
        )
        cmd = ["claude", "-p", "--model", self.model, "--output-format", "json", "--tools", "",
               "--system-prompt-file", str(sys_file)]
        try:
            proc = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=120,
                                  cwd=str(self.project.root))
        except FileNotFoundError:
            raise UIError("`claude` not found on PATH")
        except subprocess.TimeoutExpired:
            raise UIError("claude -p timed out")
        if proc.returncode != 0:
            raise UIError(f"claude -p failed: {(proc.stderr or proc.stdout).strip()[:400]}")
        try:
            data = json.loads(proc.stdout)
        except json.JSONDecodeError:
            return proc.stdout
        return data.get("result") or ""


def make_backend(project: Project, model: str, think: bool) -> Backend:
    choice = os.environ.get("UI_BACKEND", "").lower()
    if choice in ("claude", "cli", "claude-cli"):
        return ClaudeCLIBackend(project, model)
    if choice == "api" or _has_api_credentials() or not shutil.which("claude"):
        try:
            return APIBackend(model, think)
        except ImportError:
            pass
    if choice != "api" and not os.environ.get("UI_NO_UV") and shutil.which("uv") and _has_api_credentials():
        # Re-run this script with the anthropic SDK available (uv caches the env).
        env = dict(os.environ, UI_NO_UV="1")
        os.execvpe("uv", ["uv", "run", "--quiet", "--script", str(Path(__file__).resolve())] + sys.argv[1:], env)
    if shutil.which("claude"):
        print("note: no API key/SDK — using `claude -p` (slower: CLI startup + large prompt). "
              "For the fast path set ANTHROPIC_API_KEY and install uv, or use /ui inside Claude Code.", file=sys.stderr)
        return ClaudeCLIBackend(project, model)
    raise UIError("no model backend: install uv (`brew install uv`) and set ANTHROPIC_API_KEY, "
                  "`pip3 install anthropic`, or install Claude Code (`claude`).")


def _has_api_credentials() -> bool:
    if os.environ.get("ANTHROPIC_API_KEY") or os.environ.get("ANTHROPIC_AUTH_TOKEN"):
        return True
    return (Path.home() / ".config" / "anthropic").exists()


VARIANT_DIRECTIONS = [
    "a refined, conservative take that stays close to the current design",
    "a bolder take: stronger color, contrast and type hierarchy",
    "a different arrangement or layout of the same content",
    "a minimal, airy take with more whitespace and fewer accents",
    "a playful take with rounder shapes and warmer color",
]


def request_ops(project: Project, backend: Backend, context: str, system: str, request: str,
                retries: int = 1, base=None):
    """One model round trip (plus one corrective retry): returns (ops, say, model_seconds).
    `base` (design texts) validates against that design instead of the files on disk."""
    t0 = time.time()
    if not context:
        context = build_context(project, request=request)
    messages = [{"role": "user", "content": user_prompt(context, request, 1)}]
    last_err = None
    for attempt in range(retries + 1):
        text = backend.complete(system, messages, 2048)
        data = extract_json(text)
        try:
            if not isinstance(data, (dict, list)):
                raise UIError("reply was not JSON")
            ops = parse_ops(data)
            dry_run(project, ops, base)
            say = data.get("say", "") if isinstance(data, dict) else ""
            return ops, say, time.time() - t0
        except UIError as e:
            last_err = e
            if attempt >= retries:
                break
            messages.append({"role": "assistant", "content": text})
            messages.append({"role": "user", "content": f"That failed: {e}\nReply with corrected JSON only."})
    raise UIError(f"model ops failed: {last_err}")


def ask(project: Project, backend: Backend, request: str, variants: int = 1, dry: bool = False,
        shot: bool = False, retries: int = 1) -> dict:
    context = build_context(project, request=request)
    system = system_prompt(project)
    live = Live(project)
    if variants > 1:
        return ask_variants(project, backend, context, system, request, variants, dry, shot)
    ops, say, model_s = request_ops(project, backend, context, system, request, retries)
    if not ops:
        raise Escalate(say or "the model returned no ops")
    if dry:
        print(json.dumps(ops, indent=2, ensure_ascii=False))
        return {"ops": ops}
    res = run_ops(project, ops, note=request, shot=shot, quiet=True)
    print(f"ok  {say or 'done'}")
    print_result_short(project, res, model_s)
    live.timing({"kind": "ask", "backend": backend.name, "model": backend.model, "model_s": round(model_s, 3),
                 "write_s": round(res["write_ms"] / 1000, 3), "render_s": round(res.get("render_s") or 0, 3),
                 "ops": len(ops), **{f"tok_{k}": v for k, v in (backend.last_usage or {}).items()}})
    return res


def ask_variants(project: Project, backend: Backend, context: str, system: str, request: str, n: int,
                 dry: bool, shot: bool) -> dict:
    """N parallel calls (one per design direction). The first valid one is shown at once;
    the rest are staged for ./ui next as they arrive."""
    n = max(2, min(n, len(VARIANT_DIRECTIONS)))
    t0 = time.time()
    # Every variant applies to the design as it is now, even after the first one is on screen.
    base = Design(project).snapshot_texts()

    def one(i: int):
        hint = f"{request}\n\nDesign direction for this variant: {VARIANT_DIRECTIONS[i]}. Make it clearly distinct."
        ops, say, secs = request_ops(project, backend, context, system, hint, base=base)
        return {"name": say or VARIANT_DIRECTIONS[i].split(":")[0], "ops": ops, "seconds": round(secs, 2)}

    got = []
    failures = []
    started = False
    with concurrent.futures.ThreadPoolExecutor(max_workers=n) as pool:
        futures = [pool.submit(one, i) for i in range(n)]
        for fut in concurrent.futures.as_completed(futures):
            try:
                v = fut.result()
            except UIError as e:
                failures.append(str(e))
                continue
            if not v["ops"]:
                failures.append(v["name"])
                continue
            got.append(v)
            if dry:
                continue
            if not started:
                start_variants(project, [v], request, time.time() - t0, shot)
                started = True
            else:
                add_variant(project, v)
    if dry:
        print(json.dumps(got, indent=2, ensure_ascii=False))
        return {"variants": got}
    if not got:
        raise UIError("no usable variants: " + "; ".join(failures[:3]))
    Live(project).timing({"kind": "variants", "backend": backend.name, "model": backend.model, "n": n,
                          "first_s": min(v["seconds"] for v in got), "all_s": round(time.time() - t0, 3)})
    print(f"    {len(got)} variants ready ({time.time() - t0:.1f}s) — ./ui next | prev | keep")
    return {"variants": got}


