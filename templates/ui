def start_variants(project: Project, variants: list, request: str, model_s: float, shot: bool) -> dict:
    base = Design(project).snapshot_texts()
    live = Live(project)
    write_atomic(live.dir / "variants.json", dump({"request": request, "base": base, "variants": variants, "current": -1}))
    print(f"ok  first variant in {model_s:.2f}s")
    return show_variant(project, 0, shot=shot)


def add_variant(project: Project, variant: dict) -> None:
    live = Live(project)
    state = live.read("variants.json")
    if not state:
        return
    state["variants"].append(variant)
    write_atomic(live.dir / "variants.json", dump(state))
    print(f"    + variant {len(state['variants'])}: {variant['name']}")


def show_variant(project: Project, index: int, shot: bool = False) -> dict:
    live = Live(project)
    state = live.read("variants.json")
    if not state:
        raise UIError("no variants in progress (use ./ui ask -n 3 \"...\")")
    vs = state["variants"]
    index %= len(vs)
    first = state.get("current", -1) == -1
    var = vs[index]
    note = f"{state['request']} [variant {index + 1}: {var['name']}]"
    # Variants are always applied on top of the base design, in one write. Only
    # the first one takes an undo snapshot, so one `undo` returns to the base.
    res = run_ops(project, var["ops"], note=note, shot=shot, quiet=True, record=first,
                  start_texts=state["base"], snapshot=first)
    state["current"] = index
    write_atomic(live.dir / "variants.json", dump(state))
    st = res.get("status")
    where = f" · live on '{st.get('screen')}'" if isinstance(st, dict) else ""
    print(f"ok  variant {index + 1}/{len(vs)}: {var['name']}{where}")
    if res.get("shot"):
        print(f"    screenshot: {res['shot']}")
    return res


