PROP_ORDER = ["text", "symbol", "url", "asset", "name", "items", "variant", "style", "action", "onTap", "bind",
              "placeholder", "options", "header", "footer", "visibleIf"]


def fmt_value(v, limit: int = 70) -> str:
    if isinstance(v, str):
        s = v if len(v) <= limit else v[:limit - 1] + "…"
        return json.dumps(s, ensure_ascii=False)
    s = compact(v)
    return s if len(s) <= limit else s[:limit - 1] + "…"


def fmt_props(node: dict) -> str:
    keys = [k for k in PROP_ORDER if k in node] + sorted(k for k in node if k not in PROP_ORDER and k not in STRUCTURAL)
    # actions are shown in full: a model may copy them back
    return " ".join(f"{k}={compact(node[k]) if k in ('action', 'onTap') else fmt_value(node[k])}" for k in keys)


def outline(node, depth: int = 0, lines=None, data=None) -> list:
    lines = [] if lines is None else lines
    if not isinstance(node, dict):
        return lines
    pad = "  " * depth
    t = node.get("type", "?")
    extra = ""
    if t == "repeat" and isinstance(node.get("items"), str) and data is not None:
        items = resolve_path(data, node["items"].lstrip("$").replace("data.", "", 1))
        if isinstance(items, list):
            extra = f"  ({len(items)} items)"
    lines.append(f"{pad}{node.get('id', '(no id)')} {t} {fmt_props(node)}{extra}".rstrip())
    for c in node.get("children") or []:
        outline(c, depth + 1, lines, data)
    if isinstance(node.get("template"), dict):
        lines.append(f"{pad}  template:")
        outline(node["template"], depth + 2, lines, data)
    return lines


def tokens_summary(tokens: dict) -> list:
    out = []
    for group in ("colors", "colorsDark", "fonts", "spacing", "radius", "shadows", "styles"):
        g = tokens.get(group)
        if not isinstance(g, dict) or not g:
            continue
        if group == "fonts":
            parts = []
            for k, v in g.items():
                if isinstance(v, dict):
                    parts.append(f"{k}={'/'.join(str(v[x]) for x in ('size', 'weight', 'design') if x in v)}")
                else:
                    parts.append(f"{k}={v}")
            out.append(f"fonts: {' '.join(parts)}")
        elif group in ("shadows",):
            out.append(f"shadows: {' '.join(g)}")
        elif group == "styles":
            out.append("styles: " + " ".join(f"{k}={compact(v)}" for k, v in g.items()))
        else:
            out.append(f"{group}: " + " ".join(f"{k}={v}" for k, v in g.items()))
    return out


def mentions(design: Design, screen: str, request: str) -> list:
    """Quoted or on-screen text named in the request -> ids (saves the model a guess)."""
    if not request:
        return []
    wanted = [q.strip() for q in re.findall(r"[\"“'‘]([^\"”'’]{2,60})[\"”'’]", request)]
    low = request.lower()
    out = []
    for loc in design.walk():
        if loc.screen != screen:
            continue
        n = loc.node
        for k in ("text", "header", "placeholder"):
            v = n.get(k)
            if not isinstance(v, str) or "{{" in v or len(v) < 3:
                continue
            hit = any(w.lower() in v.lower() for w in wanted) or v.lower() in low
            if hit and n.get("id"):
                out.append(f"\"{v[:40]}\" → {n['id']}")
    return out[:6]


def build_context(project: Project, screen: str = None, request: str = "") -> str:
    d = Design(project)
    live = Live(project)
    status = live.status() or {}
    alive = live.app_alive(status)
    current = screen or (status.get("screen") if alive else None) or d.default_screen()
    if current not in d.screens:
        current = d.default_screen()
    L = []
    if d.load_errors:
        L.append("!! design files have errors: " + "; ".join(d.load_errors))
    tabs = d.app.get("tabs")
    nav = ""
    if isinstance(tabs, list):
        nav = "tabs: " + ", ".join(f"{t.get('id')}→{t.get('screen', t.get('id'))}" for t in tabs if isinstance(t, dict))
    elif d.app.get("root"):
        nav = f"root: {d.app.get('root')}"
    L.append(f"# app {d.app.get('name', '')}  ({nav})")
    if alive:
        stack = " › ".join(status.get("stack") or [])
        L.append(f"# simulator: showing '{status.get('screen')}'  stack: {stack}")
        if status.get("error"):
            L.append(f"# app design error: {status['error']}")
    else:
        L.append("# simulator: app not running")
    sel = live.read("selection.json")
    idx = d.index()
    recent = live.recent(1)
    last_at = float(recent[-1].get("at", 0)) if recent else 0
    focus = None
    if sel and sel.get("id") in idx and time.time() - float(sel.get("at", 0)) < 1800:
        loc = idx[sel["id"]]
        chain = " ‹ ".join(reversed(loc.ancestors)) if loc.ancestors else loc.screen
        L.append(f"# picked in the simulator: {sel['id']}  inside: {chain}")
        if isinstance(sel.get("row"), int):
            rep_id = next((a for a in reversed(loc.ancestors) if idx.get(a) and idx[a].node.get("type") == "repeat"), None)
            if rep_id:
                items = idx[rep_id].node.get("items")
                L.append(f"#   this is the TEMPLATE of repeat {rep_id} (row {sel['row'] + 1}; that row's content is "
                         f"{items}.{sel['row']}). Edit the template to change every row, data to change one row.")
        L.append(f"#   {compact(loc.node)[:600]}")
        if float(sel.get("at", 0)) > last_at:
            focus = sel["id"]
    if focus is None and recent:
        changed = [c for c in recent[-1].get("changed", []) if c in idx]
        if changed:
            focus = ", ".join(changed[:3]) + "  (last edited)"
    if focus:
        L.append(f"# FOCUS (\"this/it\"): {focus}")
    found = mentions(d, current, request)
    if found:
        L.append("# request mentions: " + "; ".join(found))
    L.append("")
    L.append(f"## screen {current}  (design/screens/{current}.json)")
    s = d.screens.get(current, {})
    head = {k: v for k, v in s.items() if k not in ("body", "data", "toolbar", "id")}
    if head:
        L.append("screen props: " + " ".join(f"{k}={fmt_value(v)}" for k, v in head.items()))
    if isinstance(s.get("data"), dict) and s["data"]:
        for k, v in s["data"].items():
            if isinstance(v, list):
                first = compact(v[0])[:160] if v else ""
                L.append(f"data.{k}: {len(v)} items, e.g. {first}")
            else:
                L.append(f"data.{k}: {fmt_value(v, 120)}")
    for item in s.get("toolbar") or []:
        L.append(f"toolbar ({current}.toolbar): {item.get('id')} {item.get('type')} {fmt_props(item)}")
    body = s.get("body")
    if isinstance(body, list):
        for n in body:
            outline(n, 0, L, s.get("data"))
    else:
        outline(body, 0, L, s.get("data"))
    L.append("")
    L.append("## tokens (design/tokens.json)")
    L.extend(tokens_summary(d.tokens))
    if isinstance(d.app.get("state"), dict) and d.app["state"]:
        L.append("state: " + " ".join(f"{k}={fmt_value(v, 30)}" for k, v in d.app["state"].items()))
    L.append("")
    others = [sid for sid in sorted(d.screens) if sid != current]
    if others:
        blocks = []
        for sid in others:
            sc = d.screens[sid]
            lines = [f"### {sid}  title={fmt_value(sc.get('title', ''), 40)}"]
            for item in sc.get("toolbar") or []:
                lines.append(f"toolbar ({sid}.toolbar): {item.get('id')} {item.get('type')} {fmt_props(item)}")
            body = sc.get("body")
            for n in (body if isinstance(body, list) else [body]):
                outline(n, 0, lines, sc.get("data"))
            blocks.append(lines)
        if sum(len(x) for b in blocks for x in b) < 14000:  # small app: show everything
            L.append("## other screens")
            for b in blocks:
                L.extend(b)
        else:
            L.append("## other screens (ids only; use ./ui context --screen <id> for detail)")
            for sid in others:
                sc = d.screens[sid]
                ids = [loc.node.get("id") for loc in d.walk() if loc.screen == sid][:25]
                L.append(f"{sid}: title={fmt_value(sc.get('title', ''), 40)} ids: {' '.join(i for i in ids if i)}")
    comps = (status or {}).get("components") if alive else None
    if isinstance(comps, dict) and comps:
        L.append("")
        L.append("## custom components (use {\"type\":\"custom\",\"name\":...})")
        for name, doc in sorted(comps.items()):
            L.append(f"{name}: {doc}")
    hist = live.recent(3)
    if hist:
        L.append("")
        L.append("## recent edits (newest last)")
        for h in hist:
            req = f"\"{h.get('request')}\" → " if h.get("request") else ""
            L.append(f"- {req}{'; '.join(h.get('ops', []))[:200]}")
    return "\n".join(L)


