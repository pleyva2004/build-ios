def load_symbol_names():
    """SF Symbol names from macOS (None when not on a Mac). Used to catch invented names."""
    plist = Path("/System/Library/CoreServices/CoreGlyphs.bundle/Contents/Resources/name_availability.plist")
    if not plist.exists():
        return None
    try:
        import plistlib

        with plist.open("rb") as f:
            data = plistlib.load(f)
        names = set((data.get("symbols") or {}).keys())
        return names or None
    except Exception:
        return None


_SYMBOLS = []


def symbol_names():
    if not _SYMBOLS:
        _SYMBOLS.append(load_symbol_names())
    return _SYMBOLS[0]
HEX_RE = re.compile(r"^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$")


def slug(text: str, words: int = 2) -> str:
    parts = re.findall(r"[a-z0-9]+", text.lower())
    return "-".join(parts[:words])


